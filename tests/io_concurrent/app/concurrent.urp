database dbname=concurrent.db
ffi ../../ioprobe/probe
include ../../ioprobe/probe.h
link ../../ioprobe/probe.c
timeout 4
onError ConcurrentE.err
allow url /Concurrent/main
allow url /Concurrent/count
allow url /Concurrent/hello
allow url /Concurrent/readCounter
allow url /Concurrent/readCounterSlowly
allow url /Concurrent/bumpCounter
allow url /Concurrent/failCommit
allow url /Concurrent/readCounterFor
allow url /Concurrent/readSolo
allow url /Concurrent/bumpSoloFor
allow url /Concurrent/readAndFail
safeGet Concurrent/main
safeGet Concurrent/count
safeGet Concurrent/hello
safeGet Concurrent/readCounter
safeGet Concurrent/readCounterSlowly
safeGet Concurrent/bumpCounter
safeGet Concurrent/failCommit
safeGet Concurrent/readCounterFor
safeGet Concurrent/readSolo
safeGet Concurrent/bumpSoloFor
safeGet Concurrent/readAndFail

$/option
concurrentE
concurrent
