### buildPhase
runHook preBuild
# Without -sql, the schema goes where the .urp says, relative to the .urp; the directory has to exist.
sql=$(sed -n 's/#.*//; s/^sql[[:space:]]\{1,\}//p' app.urp | head -n 1 | sed 's/[[:space:]]*$//')
case "$sql" in
  "" | /*) ;;
  *) mkdir -p "$(dirname "$(dirname app.urp)/$sql")" ;;
esac
/nix/store/HASH-urweb-20200209/bin/urweb \
  -protocol fastcgi \
  -dbms sqlite \
  -db /nonexistent/URWEB_SQLITE_DB_PATH-is-not-set.db \
  -prefix / \
  -sql schema.sql \
   \
  -output app.exe \
  app
runHook postBuild

### installPhase
runHook preInstall
install -D app.exe $out/bin/app
install -D -m 644 schema.sql $out/share/app/schema.sql
runHook postInstall

