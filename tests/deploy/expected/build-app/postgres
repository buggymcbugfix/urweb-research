### buildPhase
runHook preBuild
/nix/store/HASH-urweb/bin/urweb \
  -protocol fastcgi \
  -dbms postgres \
  -db 'host=/nonexistent/URWEB_PQ_CON-is-not-set' \
  -prefix / \
  -sql schema.sql \
   \
  -output app.exe \
  app
runHook postBuild

### installPhase
runHook preInstall
install -D app.exe $out/bin/app
install -D -m 644 schema.sql $out/share/app/schema.sql
runHook postInstall

### passthru.urweb
{"dbms":"postgres","name":"app","prefix":"/","protocol":"fastcgi","schema":"/nix/store/HASH-app/share/app/schema.sql"}
