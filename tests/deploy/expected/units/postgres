### urweb-pg.socket
[Unit]
Description=Socket of the Ur/Web application pg

[Socket]
ListenStream=/run/urweb-pg.sock
SocketGroup=nginx
SocketMode=0660




[Install]
WantedBy=sockets.target

### urweb-pg.service
[Unit]
After=urweb-pg.socket
Description=Ur/Web application pg
Requires=urweb-pg.socket

[Service]
Environment="LOCALE_ARCHIVE=/nix/store/HASH-glibc-locales/lib/locale/locale-archive"
Environment="PATH=/nix/store/HASH-coreutils/bin:/nix/store/HASH-findutils/bin:/nix/store/HASH-gnugrep/bin:/nix/store/HASH-gnused/bin:/nix/store/HASH-systemd/bin:/nix/store/HASH-coreutils/sbin:/nix/store/HASH-findutils/sbin:/nix/store/HASH-gnugrep/sbin:/nix/store/HASH-gnused/sbin:/nix/store/HASH-systemd/sbin"
Environment="TZDIR=/nix/store/HASH-tzdata/share/zoneinfo"
Environment="URWEB_PQ_CON=dbname=urweb-pg"
Environment="URWEB_SIGFILE_PATH=/var/lib/urweb-pg/sig"
CapabilityBoundingSet=
ExecStart="/nix/store/HASH-urweb-exec" "/nix/store/HASH-app/bin/app" "-t" "8" "-q"
Group=urweb-pg
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
PrivateUsers=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=true
Restart=on-failure
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindDeny=any
StandardError=journal
StandardInput=socket
StandardOutput=journal
StateDirectory=urweb-pg
StateDirectoryMode=2770
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
UMask=0007
User=urweb-pg

[Install]
WantedBy=multi-user.target

