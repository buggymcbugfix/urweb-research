### urweb-pg.socket
[Unit]
Description=Socket of the Ur/Web application pg

[Socket]
ListenStream=/run/urweb-pg.sock
SocketGroup=nginx
SocketMode=0660




[Install]
WantedBy=sockets.target

### urweb-pg.service
[Unit]
After=urweb-pg.socket
Description=Ur/Web application pg
Requires=urweb-pg.socket

[Service]
Environment="LOCALE_ARCHIVE=/nix/store/HASH-glibc-locales-2.42-67/lib/locale/locale-archive"
Environment="PATH=/nix/store/HASH-coreutils-9.11/bin:/nix/store/HASH-findutils-4.11.0/bin:/nix/store/HASH-gnugrep-3.12/bin:/nix/store/HASH-gnused-4.10/bin:/nix/store/HASH-systemd-261.1/bin:/nix/store/HASH-coreutils-9.11/sbin:/nix/store/HASH-findutils-4.11.0/sbin:/nix/store/HASH-gnugrep-3.12/sbin:/nix/store/HASH-gnused-4.10/sbin:/nix/store/HASH-systemd-261.1/sbin"
Environment="TZDIR=/nix/store/HASH-tzdata-2026c/share/zoneinfo"
Environment="URWEB_PQ_CON=dbname=urweb-pg"
Environment="URWEB_SIGFILE_PATH=/var/lib/urweb-pg/sig"
CapabilityBoundingSet=
ExecStart="/nix/store/HASH-app-0/bin/app" "-t" "8" "-q"
Group=urweb-pg
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
PrivateUsers=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=true
Restart=on-failure
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindDeny=any
StandardError=journal
StandardInput=socket
StandardOutput=journal
StateDirectory=urweb-pg
StateDirectoryMode=2770
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
UMask=0007
User=urweb-pg

[Install]
WantedBy=multi-user.target

