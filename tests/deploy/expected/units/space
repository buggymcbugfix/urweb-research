### urweb-app.socket
[Unit]
Description=Socket of the Ur/Web application app

[Socket]
ListenStream=/run/urweb-app.sock
SocketGroup=nginx
SocketMode=0660




[Install]
WantedBy=sockets.target

### urweb-app.service
[Unit]
After=urweb-app.socket
Description=Ur/Web application app
Requires=urweb-app.socket

[Service]
Environment="LOCALE_ARCHIVE=/nix/store/HASH-glibc-locales/lib/locale/locale-archive"
Environment="PATH=/nix/store/HASH-coreutils/bin:/nix/store/HASH-findutils/bin:/nix/store/HASH-gnugrep/bin:/nix/store/HASH-gnused/bin:/nix/store/HASH-systemd/bin:/nix/store/HASH-coreutils/sbin:/nix/store/HASH-findutils/sbin:/nix/store/HASH-gnugrep/sbin:/nix/store/HASH-gnused/sbin:/nix/store/HASH-systemd/sbin"
Environment="TZDIR=/nix/store/HASH-tzdata/share/zoneinfo"
Environment="URWEB_SIGFILE_PATH=/var/lib/urweb-app/sig"
Environment="URWEB_SQLITE_DB_PATH=/var/lib/my db/app.db"
CapabilityBoundingSet=
ExecStart="/nix/store/HASH-urweb-exec" "/nix/store/HASH-app/bin/app" "-t" "8" "-q"
ExecStartPre=/nix/store/HASH-unit-script-urweb-app-pre-start/bin/urweb-app-pre-start
Group=urweb-app
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
PrivateUsers=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths="-/var/lib/my db"
RemoveIPC=true
Restart=on-failure
RestrictAddressFamilies=none
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindDeny=any
StandardError=journal
StandardInput=socket
StandardOutput=journal
StateDirectory=urweb-app
StateDirectoryMode=2770
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
UMask=0007
User=urweb-app

[Install]
WantedBy=multi-user.target

### urweb-app.service preStart
dir='/var/lib/my db'
if [ ! -d "$dir" ]; then
  echo "$dir does not exist. It is the directory of database.path, which the deployment makes, with the group urweb-app." >&2
  exit 1
fi
exec /nix/store/HASH-util-linux-bin/bin/flock "$dir" /nix/store/HASH-urweb-app-create-database

### app-db
#!/nix/store/HASH-bash/bin/bash
umask 007
exec /nix/store/HASH-sqlite-bin/bin/sqlite3 -cmd "PRAGMA foreign_keys = ON" '/var/lib/my db/app.db' "$@"


### user urweb-app
group urweb-app

### nginx upstream urweb-app
servers unix:/run/urweb-app.sock
keepalive 32;

### tmpfiles
z /var/lib/my db/app.db 0660 - urweb-app -
z /var/lib/my db/app.db-shm 0660 - urweb-app -
z /var/lib/my db/app.db-wal 0660 - urweb-app -

