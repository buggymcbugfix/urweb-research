### urweb-erp.socket
[Unit]
Description=Socket of the Ur/Web application erp

[Socket]
ListenStream=/run/urweb-erp.sock
SocketGroup=nginx
SocketMode=0660




[Install]
WantedBy=sockets.target

### urweb-erp.service
[Unit]
After=urweb-erp.socket
Description=Ur/Web application erp
Requires=urweb-erp.socket

[Service]
Environment="LOCALE_ARCHIVE=/nix/store/HASH-glibc-locales-2.44-57/lib/locale/locale-archive"
Environment="PATH=/nix/store/HASH-coreutils-9.12/bin:/nix/store/HASH-findutils-4.11.0/bin:/nix/store/HASH-gnugrep-3.12/bin:/nix/store/HASH-gnused-4.10/bin:/nix/store/HASH-systemd-262/bin:/nix/store/HASH-coreutils-9.12/sbin:/nix/store/HASH-findutils-4.11.0/sbin:/nix/store/HASH-gnugrep-3.12/sbin:/nix/store/HASH-gnused-4.10/sbin:/nix/store/HASH-systemd-262/sbin"
Environment="TZDIR=/nix/store/HASH-tzdata-2026e/share/zoneinfo"
Environment="URWEB_SIGFILE_PATH=/var/lib/urweb-erp/sig"
Environment="URWEB_SQLITE_DB_PATH=/var/lib/urweb-erp/erp.db"
CapabilityBoundingSet=
ExecStart="/nix/store/HASH-urweb-exec" "/nix/store/HASH-app-0/bin/app" "-t" "8" "-q"
ExecStartPre=/nix/store/HASH-unit-script-urweb-erp-pre-start/bin/urweb-erp-pre-start
Group=urweb-erp
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
PrivateUsers=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=true
Restart=on-failure
RestrictAddressFamilies=none
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindDeny=any
StandardError=journal
StandardInput=socket
StandardOutput=journal
StateDirectory=urweb-erp
StateDirectoryMode=2770
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
UMask=0007
User=urweb-erp

[Install]
WantedBy=multi-user.target

### urweb-erp.service preStart
dir=/var/lib/urweb-erp
if [ ! -d "$dir" ]; then
  echo "$dir does not exist. It is the directory of database.path, which the deployment makes, with the group urweb-erp." >&2
  exit 1
fi
exec /nix/store/HASH-util-linux-2.42.4-bin/bin/flock "$dir" /nix/store/HASH-urweb-erp-create-database

### erp-db
#!/nix/store/HASH-bash-5.3p20/bin/bash
umask 007
exec /nix/store/HASH-sqlite-3.53.3-bin/bin/sqlite3 -cmd "PRAGMA foreign_keys = ON" /var/lib/urweb-erp/erp.db "$@"


### user urweb-erp
group urweb-erp

### nginx upstream urweb-erp
servers unix:/run/urweb-erp.sock
keepalive 32;

