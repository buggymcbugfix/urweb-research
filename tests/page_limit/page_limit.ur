(* Pages against the page limit (2048 bytes here, the least the compiler
   sets): one well within it, one of more than half of it, one over it. The
   runtime checks the limit as the page is written, and again when it
   splices the script into the finished page. The text is literal, so that
   it is written as it is, with no room reserved for escaping it. *)

fun main () : transaction page =
    return <xml><head><title>limit</title></head><body>main</body></xml>

fun small () : transaction page =
    return <xml><head><title>limit</title></head><body>
      0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789
    </body></xml>

