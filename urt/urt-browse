def write_index(directory):
    """index.html in the recordings directory: every video there, with
    its cues from its .vtt."""
    names = sorted(f[:-5] for f in os.listdir(directory) if f.endswith('.webm'))
    sections, cues = [], {}
    for name in names:
        vtt = os.path.join(directory, name + '.vtt')
        cues[name] = read_vtt(vtt) if os.path.exists(vtt) else []
        items = ''.join('<li><small>%s</small> %s</li>\n' % (vtt_time(start)[3:], html.escape(lines[0] if lines else ''))
                        for start, _, lines in cues[name])
        sections.append('<section id="%s">\n<h2>%s</h2>\n<div class="player">\n<div>\n'
                        '<video controls preload="metadata" src="%s.webm"></video>\n<div class="cue"></div>\n</div>\n'
                        '<ol>\n%s</ol>\n</div>\n</section>' % (html.escape(name), html.escape(name), html.escape(name), items))
    title = os.path.basename(os.path.dirname(os.path.abspath(directory))) or 'recordings'
    with open(os.path.join(directory, 'index.html'), 'w', encoding='utf-8') as f:
        f.write(INDEX_HTML % {'title': html.escape(title), 'sections': '\n'.join(sections),
                              'cues': json.dumps(cues, ensure_ascii=False).replace('</', '<\\/')})


# ------------------------------------------------------------ the clock

# Every document's clock is Playwright's (context.clock), which the
# driver moves page by page, from tag to tag.  A new document replays the
# clock calls made on its context, which leaves performance.now() at the
# real milliseconds that went by between the first two: set to 0 here,
# so that a document's frames fall on its own grid whatever the machine.
TICKS_JS = r"""
(() => {
    const c = globalThis.__pwClock && globalThis.__pwClock.controller;
    if (!c || c.__urt) { return; }
    c.__urt = true;
    const replay = c._replayLogOnce.bind(c);
    c._replayLogOnce = function () { const had = this._log.length; replay(); if (had) { this._now.ticks = 0; } };
})();
"""

# What moves on its own in a page, put on the page's clock (Playwright's
# moves timers, not animations, which run on the engine's own frames, in
# wall time), and the tab's visibility, which a headless engine does not
# have.  In every document, before its scripts:
#
# - Every animation (a CSS transition or animation, element.animate()) is
#   held: paused as soon as it is seen, which is at a probe or on the
#   engine's next frame, and set to where the clock says at every probe.
#   Its start, its iterations and its end are due like timers, so their
#   events come at their time; seeking one past them fires them on the
#   engine's next frame, which a probe that crossed one waits for.  An
#   endless one's iterations are not due; it never ends.  A page that
#   pauses, reverses or rates its own animations is not followed.
# - Scrolling is instant, whatever the page's CSS says, and a smooth
#   scroll asked of the API (scrollTo, scrollBy, scrollIntoView, with
#   behavior 'smooth') is the driver's own: 300ms, eased, a frame every
#   16ms, so that the page sees its scroll events at their time.
# - A wheel is an event and an exact scroll: dispatched where the pointer
#   is, and unless the page cancels it, the nearest box that can scroll
#   that way moves by the delta, at once.  The engines' own wheel scrolls
#   later and, in Firefox, by part of the delta.
# - The tab in front of a user's window is visible and has the focus, the
#   others are hidden: document.visibilityState, hidden and hasFocus()
#   say so, visibilitychange, blur and focus come when the front changes,
#   and a hidden tab gets no animation frames (they wait for its return).
MOTION_JS = r"""
(() => {
    if (globalThis.__urt) { return; }
    const pw = globalThis.__pwClock;
    const c = pw && pw.controller;
    const real = pw ? pw.builtins : globalThis;
    const urt = globalThis.__urt = {};
    const now = () => c ? c._now.time : Date.now();

    // ---- animations
    const held = new Map();     // animation -> {start, at} (at: where it was last set), or null: left alone
    const scan = () => {
        let fresh = false;
        if (!document.getAnimations) { return fresh; }
        for (const a of document.getAnimations()) {
            if (held.has(a)) { continue; }
            if (a.playState !== 'running' || !a.effect) { held.set(a, null); continue; }
            try { a.pause(); } catch (e) { held.set(a, null); continue; }
            held.set(a, {start: now(), at: -1});
            fresh = true;
        }
        return fresh;
    };
    // Where an animation's events fall, in its own time: the end of its
    // delay, each iteration but an endless one's, its end.
    const marks = (a) => {
        const t = a.effect.getComputedTiming();
        const out = [t.delay || 0];
        if (Number.isFinite(t.activeDuration)) {
            if (Number.isFinite(t.iterations) && typeof t.duration === 'number' && t.duration > 0) {
                for (let k = 1; k < t.iterations && k < 1000; k++) { out.push((t.delay || 0) + k * t.duration); }
            }
            out.push(t.endTime);
        }
        return out;
    };
    const frame = () => { scan(); real.requestAnimationFrame(frame); };
    if (real.requestAnimationFrame) { real.requestAnimationFrame(frame); }

    // ---- scrolling
    const SMOOTH = 300;
    const scrolls = new Map();  // scroller -> {from, to, start, last}
    const ease = p => p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
    const pos = s => [s.scrollLeft, s.scrollTop];
    const smooth = args => args.length > 0 && args[0] !== null && typeof args[0] === 'object' && args[0].behavior === 'smooth';
    const instant = arg => Object.assign({}, arg, {behavior: 'instant'});
    const smoothly = (scrollers, scroll) => {
        const before = scrollers.map(pos);
        scroll();
        scrollers.forEach((s, i) => {
            const to = pos(s), from = before[i];
            if (to[0] === from[0] && to[1] === from[1]) { return; }
            s.scrollLeft = from[0];
            s.scrollTop = from[1];
            scrolls.set(s, {from, to, start: now(), last: null});
        });
    };
    const page = () => document.scrollingElement || document.documentElement;
    for (const [obj, names] of [[window, ['scrollTo', 'scroll', 'scrollBy']],
                                [Element.prototype, ['scrollTo', 'scroll', 'scrollBy']]]) {
        for (const name of names) {
            const orig = obj[name];
            if (typeof orig !== 'function') { continue; }
            obj[name] = function (...args) {
                if (!smooth(args)) { return orig.apply(this, args); }
                smoothly([this === window ? page() : this], () => orig.call(this, instant(args[0])));
            };
        }
    }
    const into = Element.prototype.scrollIntoView;
    Element.prototype.scrollIntoView = function (...args) {
        if (!smooth(args)) { return into.apply(this, args); }
        const scrollers = [];
        for (let p = this.parentElement; p; p = p.parentElement) {
            if (p.scrollHeight > p.clientHeight || p.scrollWidth > p.clientWidth) { scrollers.push(p); }
        }
        if (!scrollers.includes(page())) { scrollers.push(page()); }
        smoothly(scrollers, () => into.call(this, instant(args[0])));
    };
    try {
        const sheet = new CSSStyleSheet();
        sheet.replaceSync('*, *::before, *::after { scroll-behavior: auto !important; }');
        document.adoptedStyleSheets = [...document.adoptedStyleSheets, sheet];
    } catch (e) {}

    urt.wheel = (x, y, dx, dy) => {
        const target = document.elementFromPoint(x, y) || document.body || document.documentElement;
        const ev = new WheelEvent('wheel', {deltaX: dx, deltaY: dy, deltaMode: 0, clientX: x, clientY: y,
                                            bubbles: true, cancelable: true, composed: true, view: window});
        target.dispatchEvent(ev);
        if (ev.defaultPrevented) { return false; }
        for (const [d, down] of [[dx, false], [dy, true]]) {
            if (!d) { continue; }
            const room = s => down ? (d > 0 ? s.scrollTop < s.scrollHeight - s.clientHeight : s.scrollTop > 0)
                                   : (d > 0 ? s.scrollLeft < s.scrollWidth - s.clientWidth : s.scrollLeft > 0);
            let s = target;
            for (; s && s !== document.body && s !== document.documentElement; s = s.parentElement) {
                const o = down ? getComputedStyle(s).overflowY : getComputedStyle(s).overflowX;
                if ((o === 'auto' || o === 'scroll') && room(s)) { break; }
            }
            if (!s || s === document.body || s === document.documentElement) { s = page(); }
            if (down) { s.scrollTop += d; } else { s.scrollLeft += d; }
        }
        return true;
    };

    // Whether an animation moves the element: one of its own or of an
    // element around it, under way or in its delay.
    urt.moving = (el) => {
        for (const [a, h] of held) {
            const target = h !== null && a.effect && a.effect.target;
            if (target && (target === el || target.contains(el))) { return true; }
        }
        return false;
    };

    // ---- the page at t: [whether anything happened that the engine
    // reports on its next frame, when the next thing is due or null,
    // how many animations are under way]
    urt.step = (t) => {
        let crossed = scan(), next = null, running = 0;
        const due = at => { if (next === null || at < next) { next = at; } };
        for (const [a, h] of held) {
            if (h === null) { continue; }
            if (a.playState === 'idle' || !a.effect) { held.delete(a); continue; }
            const rate = a.playbackRate || 1;
            const at = Math.max(0, (t - h.start) * rate);
            for (const m of marks(a)) {
                if (m > h.at && m <= at) { crossed = true; }
                if (m > at) { due(h.start + Math.ceil(m / rate)); }
            }
            h.at = at;
            if (at >= a.effect.getComputedTiming().endTime) {
                a.finish();
                held.delete(a);
            } else {
                a.currentTime = at;
                running++;
            }
        }
        for (const [s, r] of scrolls) {
            if (r.last === t) { continue; }
            r.last = t;
            const p = Math.min(1, (t - r.start) / SMOOTH), e = ease(p);
            // Whole pixels, which every engine keeps as they are.
            s.scrollLeft = Math.round(r.from[0] + (r.to[0] - r.from[0]) * e);
            s.scrollTop = Math.round(r.from[1] + (r.to[1] - r.from[1]) * e);
            crossed = true;
            if (p >= 1) { scrolls.delete(s); }
            else { due(r.start + Math.min(SMOOTH, 16 * (Math.floor((t - r.start) / 16) + 1))); running++; }
        }
        return [crossed, next, running];
    };

    // ---- a hidden tab's timers: a callback due while the tab is hidden
    // waits for the next multiple of the interval of the tier it falls in
    // (the last whose time hidden has passed, if it is for chained timers
    // only, one set from a timer five deep), all of them at once; the tab
    // coming back runs what waits.  [after, every, chained], in ms.
    const tiers = globalThis.__urtThrottle || [];
    let shown = true, hiddenSince = null, depth = 0;
    const held_back = new Map();   // the page's id -> {f, args, level, wake}
    const wakes = new Set();       // the times a wake-up is set for
    const setT = window.setTimeout, clearT = window.clearTimeout;
    const setI = window.setInterval, clearI = window.clearInterval;
    const wakeOf = (level) => {
        if (shown || hiddenSince === null) { return null; }
        const t = now();
        let tier = null;
        for (const x of tiers) {
            if (t - hiddenSince >= x[0] && (!x[2] || level >= 5)) { tier = x; }
        }
        if (tier === null) { return null; }
        const wake = Math.ceil(t / tier[1]) * tier[1];
        return wake > t ? wake : null;
    };
    const run = (f, args, level) => {
        const outer = depth;
        depth = level;
        try { f.apply(window, args); } finally { depth = outer; }
    };
    const wakeUp = (at) => {
        wakes.delete(at);
        const due = [...held_back].filter(([, h]) => h.wake <= at);
        for (const [id] of due) { held_back.delete(id); }
        for (const [, h] of due) { run(h.f, h.args, h.level); }
    };
    const holdBack = (id, f, args, level, wake) => {
        if (held_back.has(id)) { return; }     // an interval's iterations meanwhile come to one
        held_back.set(id, {f, args, level, wake});
        if (!wakes.has(wake)) {
            wakes.add(wake);
            setT.call(window, () => wakeUp(wake), wake - now());
        }
    };
    window.setTimeout = function (f, delay, ...args) {
        if (typeof f !== 'function') { return setT.call(window, f, delay, ...args); }
        const level = depth + 1;
        const id = setT.call(window, (...a) => {
            const wake = wakeOf(level);
            if (wake === null) { run(f, a, level); } else { holdBack(id, f, a, level, wake); }
        }, delay, ...args);
        return id;
    };
    window.setInterval = function (f, delay, ...args) {
        if (typeof f !== 'function') { return setI.call(window, f, delay, ...args); }
        let level = depth;
        const id = setI.call(window, (...a) => {
            level++;
            const wake = wakeOf(level);
            if (wake === null) { run(f, a, level); } else { holdBack(id, f, a, level, wake); }
        }, delay, ...args);
        return id;
    };
    window.clearTimeout = function (id) { held_back.delete(id); return clearT.call(window, id); };
    window.clearInterval = function (id) { held_back.delete(id); return clearI.call(window, id); };

    // ---- visibility
    Object.defineProperty(Document.prototype, 'visibilityState', {configurable: true, get() { return shown ? 'visible' : 'hidden'; }});
    Object.defineProperty(Document.prototype, 'hidden', {configurable: true, get() { return !shown; }});
    Document.prototype.hasFocus = function () { return shown; };
    const raf = window.requestAnimationFrame, caf = window.cancelAnimationFrame;
    const waiting = new Map(), moved = new Map();
    let ids = 0;
    window.requestAnimationFrame = function (f) {
        if (shown) { return raf.call(window, f); }
        const id = --ids;
        waiting.set(id, f);
        return id;
    };
    window.cancelAnimationFrame = function (id) {
        if (waiting.delete(id)) { return; }
        if (moved.has(id)) { id = moved.get(id); }
        return caf.call(window, id);
    };
    // The engine's own focus, blur and visibilitychange say nothing about
    // the tab: none reaches the page.
    const own = e => { if (e.isTrusted && (e.type === 'visibilitychange' || e.target === window)) { e.stopImmediatePropagation(); } };
    for (const type of ['focus', 'blur', 'visibilitychange']) { window.addEventListener(type, own, true); }
    urt.init = (s, since) => { shown = s; hiddenSince = s ? null : since; };
    urt.show = (s) => {
        if (s === shown) { return; }
        if (!s) {
            window.dispatchEvent(new FocusEvent('blur'));
            shown = false;
            hiddenSince = now();
            document.dispatchEvent(new Event('visibilitychange', {bubbles: true}));
        } else {
            shown = true;
            hiddenSince = null;
            document.dispatchEvent(new Event('visibilitychange', {bubbles: true}));
            window.dispatchEvent(new FocusEvent('focus'));
            for (const [id, f] of waiting) { moved.set(id, raf.call(window, f)); }
            waiting.clear();
            if (held_back.size) {
                const at = now();
                for (const h of held_back.values()) { h.wake = at; }
                setT.call(window, () => wakeUp(at), 0);
            }
        }
    };
})();
"""

# A wheel at the pointer, for MOTION_JS.
WHEEL_JS = "([x, y, dx, dy]) => globalThis.__urt ? globalThis.__urt.wheel(x, y, dx, dy) : null"

# Whether an animation moves an element, for MOTION_JS.
MOVING_JS = "(e) => globalThis.__urt ? globalThis.__urt.moving(e) : false"

# Whether a tab is shown, for MOTION_JS.
SHOW_JS = "(s) => { if (globalThis.__urt) { globalThis.__urt.show(s); } return true; }"


# A page's clock moved to t, firing what is due by then (only if anything
# is, or the clock is behind), its animations and scrolls set for t, and
# when its next thing is due: [whether anything fired, the next one's
# time or null, how many animations and scrolls are under way].  null for
# a page without the clock.  First a turn of the page's real event loop,
# so that what the page queued meanwhile (a form's submission after a
# click, which starts a navigation) has started before the answer; and
# when an animation crossed one of its events, two of the engine's frames
# after, in which the engine sends them.
PROBE_JS = r"""
(t) => {
    const pw = globalThis.__pwClock;
    const c = pw && pw.controller;
    if (!c) { return null; }
    const u = globalThis.__urt;
    const frames = n => new Promise(r => {
        const f = k => k ? pw.builtins.requestAnimationFrame(() => f(k - 1)) : pw.builtins.setTimeout(r, 0);
        f(n);
    });
    return new Promise(r => pw.builtins.setTimeout(r, 0)).then(() => {
        const at = f => f ? c._now.time + (f.callAt - c._now.ticks) : null;
        const first = at(c._firstTimer());
        const due = first !== null && first <= t;
        const moved = c._now.time <= t && (c._now.time < t || due) ? c.pauseAt(t) : null;
        return Promise.resolve(moved).then(() => {
            const m = u ? u.step(t) : [false, null, 0];
            return (m[0] ? frames(2) : Promise.resolve()).then(() => {
                let next = at(c._firstTimer());
                if (m[1] !== null && (next === null || m[1] < next)) { next = m[1]; }
                return [due || m[0], next, m[2]];
            });
        });
    });
}
"""

# A new document's clock starts where the context's clock calls leave it,
# which is not where the run's clock is: the driver moves pages' clocks
# itself, page by page, and cannot make a clock call for the document to
# come while its navigation is under way, Chromium holding up every call
# into the page until it commits.  So the document is told: a script at
# the start of its head sets its clock to the time it came, then takes
# itself out, before any script of the page's runs; it also says whether
# the tab is shown.
CLOCK_SCRIPT = ('<script>(() => { const c = globalThis.__pwClock && globalThis.__pwClock.controller; '
                'if (c) { c.now(); c._now.time = %d; } if (globalThis.__urt) { globalThis.__urt.init(%s, %s); } '
                'document.currentScript.remove(); })()</script>')


def with_clock(body, now, shown, hidden_since):
    """An HTML document with CLOCK_SCRIPT for now put first: in its head,
    or after its html tag or doctype if it has none."""
    script = (CLOCK_SCRIPT % (now, 'true' if shown else 'false',
                              'null' if hidden_since is None else hidden_since)).encode()
    for pattern in (rb'<head(\s[^>]*)?>', rb'<html(\s[^>]*)?>', rb'<!doctype[^>]*>'):
        m = re.search(pattern, body, re.I)
        if m:
            return body[:m.end()] + script + body[m.end():]
    return script + body


PHASE_SERVER, PHASE_DELIVERY, PHASE_USER = 0, 1, 2

TRACE = bool(os.environ.get('URT_BROWSE_TRACE'))


def trace(*what):
    """What the scheduler does, on stderr, with URT_BROWSE_TRACE set."""
    if TRACE:
        print('trace %.3f' % time.monotonic(), *what, file=sys.stderr, flush=True)


def dt(ms):
    return datetime.datetime.fromtimestamp(ms / 1000, datetime.timezone.utc)


class Held:
    """A request in the driver's hands: from the page that sent it, at
    sent, to the server at arrived, back to the page at delivered."""

    def __init__(self, tab, route, poll, sent):
        self.tab, self.route, self.req, self.poll, self.sent = tab, route, route.request, poll, sent
        self.arrived = self.delivered = self.response = self.error = None
        self.task = None            # a poll's fetch
        self.released = False       # a poll the server has let go, its tag given
        self.finished = False       # the page has it
        self.navigation = False     # a document for the tab


class Tab:
    """An open tab: its user, its name, its page, its clock and next
    timer, the dialog it shows and the answers queued for it, where its
    pointer is, its recording."""

    def __init__(self, user, name, page):
        self.user, self.name, self.page = user, name, page
        self.label = '%s.%s' % (user.name, name)
        self.clock = None
        self.next_timer = None
        self.loading = False        # from a navigation's request to the page's load
        self.navigating = False     # from a navigation's request to its commit
        self.awaiting = False       # a navigation called whose request has not been seen yet
        self.left = None            # when the document began to go: a navigation's start, or the closing
        self.busy = None            # a call into the page that has not come back
        self.navigations = []       # goto/back/... calls under way
        self.dialog = None
        self.answers = []
        self.pointer = (0.0, 0.0)
        self.animating = 0          # animations and scrolls under way in the page, as of its last probe
        self.shown = True           # what the page was told: whether it is the tab in front
        self.hidden_since = None    # since when the tab has not been in front, while it is not
        self.parked = None          # (dialog, answer) of a dialog shown while the tab was not in front
        self.closed = False
        self.video = None
        self.watchers = []          # futures of calls a dialog would hold up
        self.pending = []           # calls a dialog holds up


class TabRecord:
    """What one tab did during one step."""

    def __init__(self):
        self.requests = []     # [method, path, status or None]: the step's own
        self.late = []         # [method, path, status, step]: earlier steps' requests answered now
        self.dialogs = []
        self.console = []


class StepRecord:
    def __init__(self, name):
        self.name = name
        self.tabs = {}         # label -> TabRecord
        self.timeline = []     # (start, end or None, text)

    def tab(self, label):
        if label not in self.tabs:
            self.tabs[label] = TabRecord()
        return self.tabs[label]


class User:
    """A user: their browser, their tabs in the order of opening, the one
    in front, the labels passed in this step; and while a step runs, the
    coroutine doing their lines, which parks whenever time has to pass or
    something has to happen, until the scheduler resumes it."""

    def __init__(self, run, name, rank):
        self.run, self.name, self.rank = run, name, rank
        self.context = None
        self.tabs = []
        self.front = None
        self.labels = set()
        self.lines = []
        self.task = None
        self.future = None
        self.parked = asyncio.Event()
        self.waiting = None         # (predicate, token, future) while waiting for something to happen
        self.waiting_kind = None
        self.token = 0
        self.done = True
        self.expect_tab = None      # the name a tab the current act opens gets
        self.unborn = None          # a tab the page opened, its page not yet reported
        self.box = None             # ((tab, locator), when, box): an element being watched for stillness

    # ---- parking

    async def park(self, fut):
        self.future = fut
        self.parked.set()
        return await fut

    async def sleep_until(self, tag):
        """Until the clock is at tag (at least now), then on."""
        fut = asyncio.get_running_loop().create_future()
        self.run.push(max(tag, self.run.now), PHASE_USER, self.rank, functools.partial(self.run.resume, self, fut, None))
        await self.park(fut)

    async def wait_for(self, predicate, bound, why, kind=None, settled=False):
        """Until predicate (a coroutine function) holds at the end of a
        tag, at most bound ms from now (None: no bound); raise Complaint
        with why() if the bound comes first.  With settled, not before
        the pages have settled after what the user just did."""
        if not settled and await predicate():
            return
        self.token += 1
        token = self.token
        fut = asyncio.get_running_loop().create_future()
        self.waiting = (predicate, token, fut)
        self.waiting_kind = kind
        if bound is not None:
            self.run.push(self.run.now + bound, PHASE_USER, self.rank,
                          functools.partial(self.run.time_out, self, token))
        try:
            result = await self.park(fut)
        finally:
            self.waiting = None
            self.waiting_kind = None
        if result == 'timeout':
            raise Complaint(why())

    # ---- the lines

    async def go(self):
        a = None
        try:
            await self.sleep_until(self.run.now)
            for a in self.lines:
                start = self.run.now
                if self.front is not None and not self.front.closed:
                    self.run.cue(self.front, '%s \u00b7 %s: %s' % (self.run.step.name, self.name, a.text))
                await self.do(a)
                self.run.step.timeline.append((start, self.run.now, '%s: %s' % (self.name, a.text)))
        except Complaint as e:
            self.run.fail(self, a, str(e))
        except self.run.PlaywrightError as e:
            self.run.fail(self, a, self.run.complaint(e))
        except asyncio.CancelledError:
            pass
        finally:
            self.done = True
            self.future = None
            self.parked.set()

    def front_tab(self):
        if self.front is None or self.front.closed:
            raise Complaint('%s has no tab in front' % self.name)
        return self.front

    def time_of(self, a):
        return a.time if a.time is not None else self.run.setup.time_of(self.name, a.verb)

    async def do(self, a):
        run, verb = self.run, a.verb
        self.run.current[self.name] = a
        if verb == 'wait':
            await self.sleep_until(run.now + a.time)
        elif verb == 'label':
            self.labels.add(a.args[0][1])
        elif verb == 'after':
            _, who, name = a.args[0]
            other = run.users[who]
            await self.wait_for(lambda: self.label_passed(other, name), None,
                                lambda: '%s."%s" never came' % (who, name), kind=('after', who, name))
        elif verb == 'dialog':
            tab = self.front_tab()
            kind = a.args[0]
            tab.answers.append((kind, a.args[1] if kind == 'answer' else None, self.time_of(a)))
        elif verb == 'until':
            tab = self.front_tab()
            gone = 'gone' in a.flags
            bound = self.time_of(a)
            await self.wait_for(lambda: self.shown(tab, a.args[0], gone), bound,
                                lambda: "'%s' %s after %s" % (a.args[0], 'is still there' if gone else 'did not show',
                                                              show_time(bound)))
        elif verb == 'tab':
            name = a.args[0]
            tab = next((t for t in self.tabs if t.name == name and not t.closed), None)
            if tab is None:
                raise Complaint('%s has no tab %s' % (self.name, name))
            if tab is self.front:
                raise Complaint('%s is in front already' % name)
            await self.sleep_until(run.now + self.time_of(a))
            self.front = tab
        elif verb == 'quit':
            await self.quit()
        else:
            await self.page_action(a)

    async def const(self, v):
        return v

    async def label_passed(self, other, name):
        if name in other.labels:
            return True
        if other.done:
            raise Complaint('%s."%s" never comes: %s is done' % (other.name, name, other.name))
        return False

    async def shown(self, tab, locator, gone):
        if tab.closed or tab.dialog or tab.navigating or self.run.is_busy(tab):
            return False
        try:
            visible = await self.run.call(tab, tab.page.locator(locator).first.is_visible())
        except self.run.PlaywrightError:
            return False
        return (not visible) if gone else bool(visible)

    # ---- page actions

    async def page_action(self, a):
        run, verb = self.run, a.verb
        target = a.named.get('target')
        D = self.time_of(a)
        self.expect_tab = target
        before = set(id(t) for t in self.tabs)
        if verb == 'open' and target is not None:
            tab = await run.open_tab(self, target)
            self.expect_tab = None
            run.navigate(tab, tab.page.goto(run.base + a.args[0], wait_until='commit', timeout=0))
        else:
            tab = self.front_tab()
            await self.act(tab, a, D)
        if not a.flags or 'async' not in a.flags:
            await self.wait_for(lambda: self.const(run.quiet(self)), None, lambda: 'never quiet', settled=True)
            run.check_navigations(self)
        if target is not None and verb != 'open':
            # The engine reports a tab a page opens in its own time (a
            # tenth of a second for Chromium's): wait for it a while, on
            # the wall clock, at this tag.
            deadline = time.monotonic() + 2
            while not [t for t in self.tabs if id(t) not in before] and time.monotonic() < deadline:
                await asyncio.sleep(0.01)
            if not [t for t in self.tabs if id(t) not in before]:
                raise Complaint('%s opened no tab to call %s' % (verb, target))
            if not a.flags or 'async' not in a.flags:
                await self.wait_for(lambda: self.const(run.quiet(self)), None, lambda: 'never quiet', settled=True)
        self.expect_tab = None

    async def ready(self, tab, locator, need):
        """Whether the element is there to act on: one of it, shown,
        enabled or editable as need says, and still; more than one is a
        mistake.  Still is the same box on two frames in a row, 16ms
        apart, while anything moves in the page (an animation, a smooth
        scroll); in a page where nothing does, nothing moves until the
        next thing due, and the element is still."""
        if tab.closed or tab.dialog or tab.navigating or self.run.is_busy(tab):
            return False
        loc = tab.page.locator(locator)
        try:
            n = await self.run.call(tab, loc.count())
            if n is None or n == 0:
                return False
            if n > 1:
                what = await self.run.call(tab, loc.evaluate_all(
                    "els => els.slice(0, 5).map(e => e.outerHTML.replace(/\\s+/g, ' ').slice(0, 60))"))
                raise Complaint("'%s' matches %d elements: %s" % (locator, n, '; '.join(what or [])))
            if not await self.run.call(tab, loc.is_visible()):
                return False
            if need == 'editable' and not await self.run.call(tab, loc.is_editable()):
                return False
            if need == 'enabled' and not await self.run.call(tab, loc.is_enabled()):
                return False
            return await self.still(tab, locator, loc)
        except self.run.PlaywrightError:
            return False

    async def still(self, tab, locator, loc):
        if not tab.animating:
            self.box = None
            return True
        run = self.run
        if await run.call(tab, loc.evaluate(MOVING_JS)):
            # An animation of its own or around it, its end due.
            self.box = None
            return False
        box = await run.call(tab, loc.bounding_box())
        if self.box is None or self.box[0] != (tab, locator) or self.box[2] != box:
            self.box = ((tab, locator), run.now, box)
            run.frame(run.now + 16)
            return False
        if run.now < self.box[1] + 16:
            run.frame(self.box[1] + 16)
            return False
        return True

    async def wait_ready(self, tab, locator, need='enabled'):
        bound = self.run.setup.time_of(self.name, 'until')
        await self.wait_for(lambda: self.ready(tab, locator, need), bound,
                            lambda: "'%s' is not there to act on after %s%s" % (
                                locator, show_time(bound), '' if need is None else ' (shown and %s)' % need))
        return tab.page.locator(locator)

    async def point(self, tab, loc, pos):
        """Where on the element the pointer goes: its middle, or pos."""
        await self.run.call(tab, loc.scroll_into_view_if_needed())
        box = await self.run.call(tab, loc.bounding_box())
        if box is None:
            raise Complaint("'%s' has no box to point at" % loc)
        if pos is None:
            return box['x'] + box['width'] / 2, box['y'] + box['height'] / 2
        m = POSITION.match(pos)
        x, xp, y, yp = float(m.group(1)), m.group(2), float(m.group(3)), m.group(4)
        if xp:
            x = box['width'] * x / 100
        if yp:
            y = box['height'] * y / 100
        return box['x'] + x, box['y'] + y

    async def input(self, tab, tag, coro_fn):
        """An input event at tag, or later if the tab is navigating then:
        it goes to the document that comes; the page's clock moved there
        first."""
        await self.sleep_until(tag)
        if tab.navigating:
            await self.wait_for(lambda: self.const(not tab.navigating or tab.closed), None,
                                lambda: 'the navigation never came')
        if tab.closed:
            raise Complaint('the tab %s is gone' % tab.label)
        await self.run.touch(tab)
        if coro_fn is not None:
            await self.run.call(tab, coro_fn(), user=self)

    async def travel(self, tab, start, end, to):
        """The pointer from where it is to `to`, a move on every frame
        from start to end."""
        x0, y0 = tab.pointer
        n = max(1, (end - start) // 16)
        for k in range(1, n + 1):
            f = k / n
            x, y = x0 + (to[0] - x0) * f, y0 + (to[1] - y0) * f
            await self.input(tab, start + (end - start) * k // n,
                             functools.partial(tab.page.mouse.move, x, y))
            tab.pointer = (x, y)

    async def act(self, tab, a, D):
        if tab.page is None:
            # A tab the page opened, whose page the engine reports only
            # once its document comes.
            await self.wait_for(lambda: self.const(tab.page is not None or tab.closed), None,
                                lambda: 'the tab %s never came' % tab.label)
        run, verb, page = self.run, a.verb, tab.page
        start = run.now
        if verb in ('click', 'dblclick', 'hover', 'check', 'uncheck'):
            loc = await self.wait_ready(tab, a.args[0], 'enabled' if verb != 'hover' else None)
            start = run.now
            if verb in ('check', 'uncheck'):
                want = verb == 'check'
                if bool(await run.call(tab, loc.is_checked())) == want:
                    await self.sleep_until(start + D)
                    return
            to = await self.point(tab, loc, a.named.get('at'))
            press = 150 if verb == 'dblclick' else 100
            if verb == 'hover':
                await self.travel(tab, start, start + D, to)
                return
            await self.travel(tab, start, max(start, start + D - press), to)
            if verb == 'dblclick':
                await self.input(tab, start + D - 150, lambda: page.mouse.down(click_count=1))
                await self.input(tab, start + D - 100, lambda: page.mouse.up(click_count=1))
                await self.input(tab, start + D - 50, lambda: page.mouse.down(click_count=2))
                await self.input(tab, start + D, lambda: page.mouse.up(click_count=2))
            else:
                await self.input(tab, max(start, start + D - 100), lambda: page.mouse.down())
                await self.input(tab, start + D, lambda: page.mouse.up())
        elif verb == 'focus':
            loc = await self.wait_ready(tab, a.args[0], None)
            await self.input(tab, run.now + D, lambda: loc.focus())
        elif verb == 'fill':
            loc = await self.wait_ready(tab, a.args[0], 'editable')
            await self.input(tab, run.now + D, lambda: loc.fill(a.args[1]))
        elif verb == 'type':
            loc = await self.wait_ready(tab, a.args[0], 'editable')
            start = run.now
            await self.input(tab, start, lambda: loc.focus())
            for i, ch in enumerate(a.args[1]):
                await self.input(tab, start + i * D, functools.partial(page.keyboard.type, ch))
            await self.sleep_until(start + len(a.args[1]) * D)
        elif verb == 'press':
            key = a.args[0]
            if 'on' in a.named:
                loc = await self.wait_ready(tab, a.named['on'], 'enabled')
                await self.input(tab, run.now, lambda: loc.focus())
            start = run.now
            if '+' in key[1:] or len(key) == 1:
                await self.input(tab, start, functools.partial(page.keyboard.press, key))
                await self.sleep_until(start + D)
            else:
                await self.input(tab, start, functools.partial(page.keyboard.down, key))
                await self.input(tab, start + D, functools.partial(page.keyboard.up, key))
        elif verb == 'select':
            loc = await self.wait_ready(tab, a.args[0], 'enabled')
            await self.input(tab, run.now + D, lambda: loc.select_option(a.args[1:]))
        elif verb == 'wheel':
            # The page's own: dispatched where the pointer is, and the
            # scroll exact and at once (MOTION_JS).
            x, y = tab.pointer
            await self.input(tab, start, functools.partial(page.evaluate, WHEEL_JS,
                                                           [x, y, float(a.args[0]), float(a.args[1])]))
            await self.sleep_until(start + D)
        elif verb == 'drag':
            source = await self.wait_ready(tab, a.args[0], None)
            target = await self.wait_ready(tab, a.args[1], None)
            start = run.now
            frm = await self.point(tab, source, a.named.get('from'))
            await self.travel(tab, start, start + D * 3 // 10, frm)
            await self.input(tab, start + D * 3 // 10, lambda: page.mouse.down())
            to = await self.point(tab, target, a.named.get('to'))
            await self.travel(tab, start + D * 3 // 10, start + D * 9 // 10, to)
            # At rest over the target before the release.
            await self.input(tab, start + D * 9 // 10 + 16, functools.partial(page.mouse.move, to[0], to[1]))
            await self.input(tab, max(start + D, start + D * 9 // 10 + 16), lambda: page.mouse.up())
        elif verb == 'swipe':
            loc = await self.wait_ready(tab, a.args[0], None)
            start = run.now
            frm = await self.point(tab, loc, a.named['from'])
            to = await self.point(tab, loc, a.named['to'])
            await self.input(tab, start, functools.partial(page.mouse.move, frm[0], frm[1]))
            tab.pointer = frm
            await self.input(tab, start, lambda: page.mouse.down())
            await self.travel(tab, start, start + D, to)
            # Let go while moving: no rest.
            await self.input(tab, start + D, lambda: page.mouse.up())
        elif verb in ('open', 'back', 'forward', 'reload'):
            await self.input(tab, start, None)
            if verb == 'open':
                run.navigate(tab, page.goto(run.base + a.args[0], wait_until='commit', timeout=0))
            else:
                call = {'back': page.go_back, 'forward': page.go_forward, 'reload': page.reload}[verb]
                run.navigate(tab, call(wait_until='commit', timeout=0), verb)
            await self.sleep_until(start + D)
        elif verb == 'close':
            await self.sleep_until(start + D)
            await run.close_tab(tab)

    async def quit(self):
        for tab in list(self.tabs):
            tab.closed = True
        self.tabs, self.front = [], None
        if self.context is not None:
            context, self.context = self.context, None
            await context.close()


class Run:
    """One run through one engine: the clock, the users, the requests in
    the driver's hands, the server's clock, the records."""

    def __init__(self, drv, url, run_dir, out, steps, setup, order, screenshots, recordings):
        self.drv, self.args = drv, drv.args
        self.PlaywrightError = drv.PlaywrightError
        self.browser = drv.browser
        # The server's address, and the one the pages are given: the same
        # host on a port that refuses every connection, so that nothing an
        # engine does on its own (WebKit connects ahead of a request it
        # expects, and the single-threaded server would wait for it)
        # reaches the server; every request goes through the driver.
        self.server = url.rstrip('/')
        self.server_origin = re.sub(r'^https?://', '', self.server)
        host, _, port = self.server_origin.partition(':')
        self.host, self.port = host, int(port or 80)
        self.closed_port = socket.socket()
        self.closed_port.bind((host, 0))
        self.base = 'http://%s:%d' % (host, self.closed_port.getsockname()[1])
        self.origin = re.sub(r'^https?://', '', self.base)
        self.run_dir, self.out = run_dir, out
        self.steps, self.setup = steps, setup
        self.screenshots, self.recordings = screenshots, recordings
        self.now = int(round(self.args.epoch * 1000))
        self.queue = []
        self.seq = 0
        self.users = {name: User(self, name, rank) for rank, name in enumerate(order)}
        self.page_tab = {}
        self.held = []              # Held, until the page has it
        self.polls = []             # polls at the server, in the order they finished
        self.released = 0           # polls the server says it let go
        self.attributed = 0         # of those, the ones given a tag
        self.server_next = None
        self.activity = 0
        self.step = None
        self.error = None
        self.current = {}           # user -> the action under way
        self.videos = []
        self.creating = False
        self.open_requests = {}     # request -> (step, label, index)
        self.refused = set()
        self.heldmap = {}           # request -> Held
        self.frames = set()         # frame stops to come

    # ---- the queue

    def push(self, tag, phase, rank, fn):
        self.seq += 1
        heapq.heappush(self.queue, (tag, phase, rank, self.seq, fn))

    def pop(self, tag, phase):
        out = []
        rest = []
        while self.queue and self.queue[0][0] <= tag:
            e = heapq.heappop(self.queue)
            (out if e[1] == phase else rest).append(e)
        for e in rest:
            heapq.heappush(self.queue, e)
        return [e[4] for e in sorted(out)]

    def has_events(self, tag):
        return bool(self.queue) and self.queue[0][0] <= tag

    def frame(self, tag):
        """A stop at tag, for a user watching something move."""
        if tag not in self.frames:
            self.frames.add(tag)
            self.push(tag, PHASE_USER, -1, functools.partial(self.framed, tag))

    async def framed(self, tag):
        self.frames.discard(tag)

    async def resume(self, user, fut, value):
        if fut.done() or user.future is not fut:
            return
        trace('resume', user.name, value)
        user.parked.clear()
        fut.set_result(value)
        await user.parked.wait()

    async def time_out(self, user, token):
        if user.waiting is not None and user.waiting[1] == token:
            await self.resume(user, user.waiting[2], 'timeout')

    def fail(self, user, a, why):
        if self.error is None:
            self.error = why
            self.failed_user = user

    # ---- calls into pages

    async def call(self, tab, coro, user=None):
        """A call into a page, which a dialog the page shows holds up
        until it is answered, at a later tag.  A user waits for that; for
        anyone else the call is left to finish then, and gives None."""
        if tab.dialog is not None:
            if user is None:
                coro.close()
                return None
            await user.wait_for(lambda: self.const(tab.dialog is None), None, lambda: 'the dialog was never answered')
        task = asyncio.ensure_future(coro)
        shown = asyncio.get_running_loop().create_future()
        tab.watchers.append(shown)
        try:
            done, _ = await asyncio.wait({task, shown}, timeout=self.args.timeout, return_when=asyncio.FIRST_COMPLETED)
        finally:
            if shown in tab.watchers:
                tab.watchers.remove(shown)
        if task in done:
            return task.result()
        if not done:
            task.cancel()
            raise Complaint('the page of %s did not answer within %gs' % (tab.label, self.args.timeout))
        tab.pending.append(task)
        if user is None:
            return None
        await user.wait_for(lambda: self.const(tab.dialog is None and task.done()), None,
                            lambda: 'the dialog was never answered')
        return task.result()

    async def const(self, v):
        return v

    def is_busy(self, tab):
        return tab.busy is not None and not tab.busy.done()

    async def touch(self, tab):
        """The tab's page with its clock at now, what is due by then
        fired; and its next timer.  Not while it navigates: Chromium
        answers no call into a page until its navigation commits, which
        comes at a later tag (and the old document's timers due meanwhile
        go with it, in every engine alike); nor while a call before has
        not come back, in case it is held up by a navigation not known
        yet (one after a redirect)."""
        if tab.closed or tab.dialog or tab.navigating or self.is_busy(tab):
            return
        task = asyncio.ensure_future(tab.page.evaluate(PROBE_JS, self.now))
        shown = asyncio.get_running_loop().create_future()
        tab.watchers.append(shown)
        try:
            done, _ = await asyncio.wait({task, shown}, timeout=0.5, return_when=asyncio.FIRST_COMPLETED)
        finally:
            if shown in tab.watchers:
                tab.watchers.remove(shown)
        if task not in done:
            trace('busy', tab.label)
            tab.busy = task
            task.add_done_callback(lambda t: t.exception() if not t.cancelled() else None)
            if done:
                tab.pending.append(task)
            return
        try:
            r = task.result()
        except self.PlaywrightError as e:
            if 'closed' in str(e).lower():
                return
            self.activity += 1      # a navigation under way: look again
            return
        if r is None:
            tab.next_timer = None
            return
        fired, nxt, tab.animating = r
        trace('touch', tab.label, fired, nxt and self.stamp(nxt), tab.animating)
        tab.clock = self.now
        tab.next_timer = nxt
        if fired:
            self.activity += 1

    # ---- browsers and tabs

    async def context_of(self, user):
        if user.context is not None:
            return user.context
        options = self.setup.options_of(user.name)
        if self.recordings:
            options['record_video_dir'] = self.recordings
            options['record_video_size'] = options['viewport']
        context = await self.browser.new_context(**options)
        context.set_default_timeout(self.args.timeout * 1000)
        await context.clock.install(time=dt(self.now - 1000))
        await context.clock.pause_at(dt(self.now))
        await context.add_init_script(TICKS_JS)
        await context.add_init_script('globalThis.__urtThrottle = %s;' % json.dumps(self.setup.throttle_of(user.name)))
        await context.add_init_script(MOTION_JS)
        if self.recordings:
            await context.add_init_script(CURSOR_JS)
        await context.route('**/*', functools.partial(self.on_route, user))
        context.on('page', lambda page: self.on_page(user, page))
        # The context's, not the page's: a tab's first request can finish
        # before the engine reports the tab.
        context.on('requestfinished', lambda r: asyncio.ensure_future(self.on_finished(r, None)))
        context.on('requestfailed', lambda r: asyncio.ensure_future(self.on_finished(r, self.failure_of(r))))
        user.context = context
        return context

    async def open_tab(self, user, name):
        context = await self.context_of(user)
        self.creating = True
        try:
            page = await context.new_page()
        finally:
            self.creating = False
        return self.adopt(user, name, page)

    def adopt(self, user, name, page):
        tab = Tab(user, name, None)
        user.tabs.append(tab)
        user.front = tab
        if page is not None:
            self.attach(tab, page)
        return tab

    def attach(self, tab, page):
        tab.page = page
        self.page_tab[page] = tab
        label = tab.label
        if self.recordings:
            n = 1 + sum(1 for v in self.videos if v.name.startswith('%s.%s.' % (label, self.args.engine)))
            vname = '%s.%s%s' % (label, self.args.engine, '.%d' % n if n > 1 else '')
            tab.video = Recording(vname, page.video.path(), time.monotonic())
            self.videos.append(tab.video)
            self.cue(tab, '%s · %s: opened' % (self.step.name if self.step else '', label), at=0.0)
        page.on('request', lambda r: self.on_request(tab, r))
        page.on('dialog', lambda d: self.on_dialog(tab, d))
        page.on('console', lambda m: self.on_console(tab, m))
        page.on('pageerror', lambda e: self.on_pageerror(tab, e))
        page.on('load', lambda: self.on_load(tab))
        page.on('framenavigated', lambda frame: self.on_navigated(tab, frame))
        page.on('close', lambda: self.on_close(tab))

    def on_page(self, user, page):
        """A tab the page opened: the act that opens it names it."""
        trace('page', user.name, page.url, user.unborn and user.unborn.label)
        if self.creating or page in self.page_tab:
            return self.page_tab.get(page)
        self.activity += 1
        tab = user.unborn
        if tab is not None:
            user.unborn = None
            self.attach(tab, page)
            if page.url not in ('', 'about:blank'):
                tab.navigating = False      # committed before the tab was reported
            if tab.closed:
                asyncio.ensure_future(self.close_page(page))
            return tab
        return self.adopt(user, self.name_tab(user), page)

    def unborn_tab(self, user):
        self.activity += 1
        user.unborn = self.adopt(user, self.name_tab(user), None)
        return user.unborn

    def name_tab(self, user):
        name = user.expect_tab
        if name is None:
            self.fail(user, None, 'a page opened a tab for %s; the action that does it names it, with [target=NAME]'
                      % user.name)
            name = '_'
        user.expect_tab = None
        return name

    def on_close(self, tab):
        self.activity += 1
        if not tab.closed:
            tab.closed = True
            self.forget(tab)

    def forget(self, tab):
        user = tab.user
        if tab in user.tabs:
            i = user.tabs.index(tab)
            user.tabs.pop(i)
            if user.front is tab:
                user.front = user.tabs[i] if i < len(user.tabs) else user.tabs[i - 1] if user.tabs else None

    async def close_tab(self, tab):
        tab.left = self.now
        tab.closed = True
        self.forget(tab)
        if tab.page is not None:
            await self.close_page(tab.page)

    async def close_page(self, page):
        try:
            await page.close()
        except self.PlaywrightError:
            pass

    def navigate(self, tab, coro, verb=None):
        """A navigation under way in the tab: its call finishes at a
        later tag, when the document comes."""
        task = asyncio.ensure_future(coro)
        task.verb = verb
        tab.navigations.append(task)
        # Under way from now on, though its request reaches the route only
        # in a moment (a tenth of a second for a new tab's first).
        tab.loading = tab.navigating = tab.awaiting = True
        tab.left = self.now
        task.add_done_callback(lambda t: self.navigated(tab, t))
        self.activity += 1

    def navigated(self, tab, task):
        """A navigation call is over: if it failed, nothing is under way
        that it started."""
        trace('navigated', tab.label, task.cancelled() or task.exception())
        self.activity += 1
        tab.awaiting = False
        if task.cancelled() or task.exception() is not None:
            tab.loading = tab.navigating = False

    def check_navigations(self, user):
        for tab in user.tabs:
            for task in list(tab.navigations):
                if not task.done():
                    continue
                tab.navigations.remove(task)
                e = task.exception()
                if e is None:
                    continue
                if 'NS_ERROR_DOCUMENT_NOT_CACHED' in str(e):
                    raise Complaint('%s to the page that answered a POST, which Firefox does not keep; '
                                    'Chromium and WebKit send the POST again' % task.verb)
                if 'interrupted by another navigation' in str(e) or 'ERR_ABORTED' in str(e) \
                        or 'NS_BINDING_ABORTED' in str(e) or 'cancelled' in str(e).lower():
                    continue
                raise Complaint(self.complaint(e))

    # ---- what the pages do

    def path_of(self, url):
        p = url
        for base in (self.base, self.server):
            if p == base or p.startswith(base + '/'):
                return p[len(base):] or '/'
        return p

    def is_poll(self, req):
        return self.path_of(req.url).split('?')[0].endswith('/.msgs')

    def on_request(self, tab, req):
        self.activity += 1
        if self.step is None:
            return
        requests = self.step.tab(tab.label).requests
        requests.append([req.method, self.path_of(req.url), None])
        self.open_requests[req] = (self.step, tab.label, len(requests) - 1)

    async def on_finished(self, req, failure):
        self.activity += 1
        h = self.heldmap.pop(req, None)
        if h is not None:
            h.finished = True
            if h in self.held:
                self.held.remove(h)
            if h.navigation and failure is not None:
                # A navigation that ends without a document.
                h.tab.navigating = h.tab.loading = False
        status = failure
        if status is None:
            try:
                resp = await req.response()
                status = resp.status if resp is not None else '?'
            except self.PlaywrightError:
                status = '?'
        where = self.open_requests.pop(req, None)
        if where is None:
            return
        step, label, i = where
        if step is self.step:
            step.tab(label).requests[i][2] = status
        elif self.step is not None:
            self.step.tab(label).late.append([req.method, self.path_of(req.url), status, step.name])
        if self.step is not None and h is not None:
            end = h.delivered if h.delivered is not None else self.now
            if failure is not None and h.delivered is None:
                # Left behind by the page: when the engine says so is a
                # matter of wall time, and of the engine (at the start of
                # the navigation away, or at its commit); the cause is the
                # navigation, or the tab's closing.
                end = h.tab.left if h.tab.left is not None and h.tab.left >= h.sent else self.now
            self.step.timeline.append((h.sent, end, '%s: %s %s %s' % (label, req.method, self.path_of(req.url), status)))

    def failure_of(self, req):
        """Why a request failed, in words that do not depend on the engine."""
        if req in self.refused:
            return 'refused'
        why = req.failure or '?'
        if 'ABORT' in why.upper() or 'cancel' in why.lower():
            return 'aborted'
        return 'failed: %s' % why

    def on_load(self, tab):
        trace('load', tab.label)
        self.activity += 1
        tab.loading = False

    def on_navigated(self, tab, frame):
        trace('framenavigated', tab.label, frame.url)
        if frame == tab.page.main_frame:
            self.activity += 1
            tab.navigating = False

    def on_console(self, tab, msg):
        if self.step is not None:
            self.step.tab(tab.label).console.append('%s: %s' % (msg.type, msg.text))

    def on_pageerror(self, tab, err):
        if self.step is not None:
            self.step.tab(tab.label).console.append('error: %s' % err.message.splitlines()[0])

    def on_dialog(self, tab, dialog):
        """A dialog blocks its page until it is answered: by the answer
        queued for the tab, or accepted, the answer's time after it shows,
        which in a tab not in front is when the user comes to it."""
        self.activity += 1
        tab.dialog = dialog
        for w in tab.watchers:
            if not w.done():
                w.set_result(True)
        answer = tab.answers.pop(0) if tab.answers else ('accept', None, self.setup.time_of(tab.user.name, 'dialog'))
        if tab is not tab.user.front:
            # Shown when the user comes to the tab, and answered after.
            tab.parked = (dialog, answer)
            return
        self.push(self.now + answer[2], PHASE_DELIVERY, tab.user.rank, functools.partial(self.answer, tab, dialog, answer))

    async def answer(self, tab, dialog, answer):
        kind, text, _ = answer
        line = '%s: %s' % (dialog.type, dialog.message)
        if dialog.type == 'prompt' and dialog.default_value:
            line += ' [%s]' % dialog.default_value
        try:
            if kind == 'dismiss':
                line += ' -- dismissed'
                await dialog.dismiss()
            else:
                if dialog.type == 'prompt':
                    line += ' -- answered %r' % (text if text is not None else '')
                else:
                    line += ' -- accepted'
                await dialog.accept(text if text is not None else '')
        except self.PlaywrightError:
            pass
        if self.step is not None:
            self.step.tab(tab.label).dialogs.append(line)
        tab.dialog = None
        # What the dialog held up goes on, at the time of the answer.
        pending, tab.pending = tab.pending, []
        for task in pending:
            try:
                await asyncio.wait_for(asyncio.shield(task), self.args.timeout)
            except Exception:
                pass
        await self.touch(tab)

    # ---- the network

    async def on_route(self, user, route):
        """Every request a page sends is held here: it reaches the server
        half a round trip later, and its answer the page half a round trip
        after that.  One for any other server is refused: a run drives
        this application, and the network is not its business."""
        self.activity += 1
        req = route.request
        url = req.url
        if not any(url == b or url.startswith(b + '/') for b in (self.base, self.server)):
            self.refused.add(req)
            await route.abort()
            return
        try:
            page = req.frame.page
        except self.PlaywrightError:
            page = None
        if page is None:
            # A tab the page opened, whose first request comes before the
            # engine reports the tab (WebKit reports it once the request
            # is answered): the tab is there from now, its page to come.
            tab = self.unborn_tab(user)
            self.on_request(tab, req)
        else:
            tab = self.page_tab.get(page) or self.on_page(user, page)
        h = Held(tab, route, self.is_poll(req), self.now)
        h.step = self.step
        trace('route', tab.label, req.method, self.path_of(url))
        self.held.append(h)
        self.heldmap[req] = h
        try:
            if req.is_navigation_request() and (page is None or req.frame == page.main_frame):
                if not tab.navigating:
                    tab.left = self.now
                tab.loading = tab.navigating = True
                tab.awaiting = False
                h.navigation = True
        except self.PlaywrightError:
            pass
        rtt = self.setup.rtt_of(tab.user.name)
        self.push(self.now + rtt // 2, PHASE_SERVER, tab.user.rank, functools.partial(self.arrive, h))

    async def arrive(self, h):
        h.arrived = self.now
        trace('arrive', h.tab.label, self.path_of(h.req.url))
        headers = {k: v for k, v in h.req.headers.items() if k.lower() != 'host'}
        headers['urweb-time'] = str(self.now)
        if h.poll:
            h.task = asyncio.ensure_future(self.fetch_poll(h, headers))
            return
        try:
            h.response = await h.route.fetch(url=self.server + self.path_of(h.req.url), headers=headers, max_redirects=0,
                                             timeout=self.args.timeout * 1000)
        except self.PlaywrightError as e:
            h.error = e
            trace('fetch failed', self.path_of(h.req.url), str(e).splitlines()[0])
        self.deliver_later(h)

    async def fetch_poll(self, h, headers):
        try:
            h.response = await h.route.fetch(url=self.server + self.path_of(h.req.url), headers=headers, max_redirects=0,
                                             timeout=0)
        except self.PlaywrightError as e:
            h.error = e
        trace('poll back', h.tab.label, h.response.status if h.response else h.error)
        self.polls.append(h)
        self.activity += 1

    def deliver_later(self, h):
        rtt = self.setup.rtt_of(h.tab.user.name)
        self.push(self.now + rtt - rtt // 2, PHASE_DELIVERY, h.tab.user.rank, functools.partial(self.deliver, h))

    async def deliver(self, h):
        tab = h.tab
        h.delivered = self.now
        trace('deliver', tab.label, self.path_of(h.req.url), h.response.status if h.response else h.error)
        if tab.closed:
            h.finished = True
            self.drop(h)
            return
        await self.touch(tab)
        try:
            # Through call: WebKit answers the fulfilling only once the
            # page has handled the answer, a dialog it shows included.
            if h.error is not None:
                await self.call(tab, h.route.abort('failed'))
            elif h.navigation and 'html' in h.response.headers.get('content-type', ''):
                tab.shown = tab is tab.user.front
                await self.call(tab, h.route.fulfill(response=h.response,
                                                     body=with_clock(await h.response.body(), self.now, tab.shown,
                                                                     tab.hidden_since)))
            else:
                await self.call(tab, h.route.fulfill(response=h.response))
        except self.PlaywrightError:
            h.finished = True
            self.drop(h)
        self.activity += 1

    def drop(self, h):
        self.heldmap.pop(h.req, None)
        if h in self.held:
            self.held.remove(h)

    # ---- the server's clock

    async def server_clock(self, advance):
        """GET /.clock[?advance=T]: what is due before T done; the next
        thing due, and how many polls the server has let go."""
        q = '/.clock' + ('?advance=%d' % advance if advance is not None else '')
        try:
            reader, writer = await asyncio.wait_for(asyncio.open_connection(self.host, self.port), self.args.timeout)
            writer.write(('GET %s HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' % q).encode())
            await writer.drain()
            data = await asyncio.wait_for(reader.read(), 60)
            writer.close()
        except (OSError, asyncio.TimeoutError) as e:
            raise Complaint('the server does not answer its clock: %s' % (e or type(e).__name__))
        head, _, body = data.decode('latin-1').partition('\r\n\r\n')
        if not head.startswith('HTTP/1.1 200'):
            raise Complaint("the server's clock answers %s" % (head.splitlines()[0] if head else 'nothing'))
        for line in body.splitlines():
            word, _, value = line.partition(' ')
            if word == 'next':
                self.server_next = None if value == 'none' else int(value)
            elif word == 'released':
                self.released = int(value)
        trace('clock', q, self.server_next and self.stamp(self.server_next), self.released)

    async def server_tag(self, t, arrivals):
        """The server's part of a tag: its tasks due then and the requests
        arriving, in the order the context says, then the polls it let go
        given this tag."""
        if self.setup.tasks == 'first':
            await self.server_clock(t + 1)
        for fn in arrivals:
            await fn()
        await self.server_clock(t + 1 if self.setup.tasks == 'last' else None)
        # A poll the server let go has its answer under way: wait for it.
        deadline = time.monotonic() + self.args.timeout
        while self.attributed + len([p for p in self.polls if not p.released]) < self.released:
            if time.monotonic() > deadline:
                raise Complaint('the server let %d polls go, and %d answers came'
                                % (self.released - self.attributed, len([p for p in self.polls if not p.released])))
            await asyncio.sleep(0.001)
        for h in self.polls:
            if not h.released:
                h.released = True
                self.attributed += 1
                self.deliver_later(h)

    # ---- tags

    def live_tabs(self):
        return [t for u in self.users.values() for t in u.tabs if not t.closed]

    def timers_on(self, tab):
        """Whether the tab's timers run now: not while a dialog holds the
        page, nor while it navigates or a call into it has not come back
        (its next timer is looked at again after)."""
        return not (tab.closed or tab.dialog or tab.navigating or self.is_busy(tab))

    def next_tag(self, extra=None):
        candidates = []
        if self.queue:
            candidates.append(self.queue[0][0])
        for tab in self.live_tabs():
            if tab.next_timer is not None and self.timers_on(tab):
                candidates.append(max(self.now, tab.next_timer))
        if self.server_next is not None:
            candidates.append(max(self.now, self.server_next))
        if extra is not None and extra > self.now:
            candidates.append(extra)
        return min(candidates) if candidates else None

    async def process_tag(self, t):
        self.now = max(self.now, t)
        t = self.now
        trace('tag', self.stamp(t))
        for _ in range(10000):
            arrivals = self.pop(t, PHASE_SERVER)
            if arrivals or (self.server_next is not None and self.server_next <= t):
                await self.server_tag(t, arrivals)
            for tab in self.live_tabs():
                if tab.next_timer is not None and tab.next_timer <= t and self.timers_on(tab):
                    await self.touch(tab)
            for fn in self.pop(t, PHASE_DELIVERY):
                await fn()
            for fn in self.pop(t, PHASE_USER):
                await fn()
                if self.error:
                    return
            await self.settle(t)
            woke = await self.wake(t)
            if self.error:
                return
            if not woke and not self.has_events(t) and not any(
                    tab.next_timer is not None and tab.next_timer <= t and self.timers_on(tab) for tab in self.live_tabs()):
                return
        raise Complaint('the pages did not come to rest at %s' % self.stamp(t))

    async def settle(self, t):
        """Until what the pages do at this tag in wall time is over: two
        rounds in a row in which nothing new came from them."""
        deadline = time.monotonic() + self.args.timeout
        quiet = 0
        while quiet < 2:
            mark = self.activity
            await self.show_fronts()
            for tab in self.live_tabs():
                await self.touch(tab)
            await asyncio.sleep(0)
            # A dialog holds up its page, and what the page would report
            # meanwhile: that comes once it is answered, at a later tag.
            delivering = [h for h in self.held if h.delivered is not None and not h.finished and not h.tab.dialog]
            delivering += [t for t in self.live_tabs() if self.coming(t)]
            trace('settle', self.activity - mark, len(delivering), quiet)
            if self.activity != mark or delivering:
                quiet = 0
                if delivering:
                    await asyncio.sleep(0.001)
            else:
                quiet += 1
            if time.monotonic() > deadline:
                raise Complaint('the pages did not settle within %gs at %s; still under way: %s'
                                % (self.args.timeout, self.stamp(t),
                                   ', '.join(self.path_of(h.req.url) if isinstance(h, Held) else h.label
                                             for h in delivering) or 'nothing known'))

    async def show_fronts(self):
        """Every user's tab in front shown, the others hidden, the ones
        that change told so: the hidden first, then the shown."""
        for user in self.users.values():
            for tab in user.tabs:
                if tab is user.front:
                    tab.hidden_since = None
                elif tab.hidden_since is None:
                    tab.hidden_since = self.now
            for want in (False, True):
                for tab in user.tabs:
                    if tab.closed or tab.page is None or (tab is user.front) != want:
                        continue
                    if want and tab.parked is not None:
                        dialog, answer = tab.parked
                        tab.parked = None
                        self.push(self.now + answer[2], PHASE_DELIVERY, user.rank,
                                  functools.partial(self.answer, tab, dialog, answer))
                    if tab.shown == want or tab.navigating or tab.dialog or self.is_busy(tab):
                        continue
                    await self.touch(tab)
                    if await self.call(tab, tab.page.evaluate(SHOW_JS, want)):
                        trace('shown' if want else 'hidden', tab.label)
                        tab.shown = want
                        self.activity += 1

    def coming(self, tab):
        """Whether the tab has something under way that comes in wall
        time, not at a later tag: the request of a navigation called,
        the commit of a document delivered, the load event of a page
        whose requests are all delivered."""
        if tab.closed or tab.dialog:
            return False
        if tab.awaiting:
            return True
        if self.is_busy(tab) and not tab.navigating:
            return True
        undelivered = any(h.tab is tab and h.delivered is None and not h.poll for h in self.held)
        if tab.navigating:
            return not any(h.tab is tab and h.navigation and h.delivered is None for h in self.held)
        return tab.loading and not undelivered

    async def wake(self, t):
        """Resume the users whose wait is over, in the tie order; whether
        any was."""
        woke = False
        for user in self.users.values():
            if user.waiting is None or self.error:
                continue
            predicate, token, fut = user.waiting
            try:
                ok = await predicate()
            except Complaint as e:
                self.fail(user, None, str(e))
                return woke
            if ok and user.waiting is not None and user.waiting[1] == token:
                await self.resume(user, fut, 'ok')
                woke = True
        return woke

    def quiet(self, user=None):
        """No request of the user's (everyone's) under way but polls, no
        page of theirs loading or showing a dialog (but in a tab not in
        front, which waits for the user)."""
        tabs = user.tabs if user is not None else self.live_tabs()
        for h in self.held:
            if not h.poll and (user is None or h.tab.user is user) and not h.tab.closed:
                return False
        return not any(t.loading or (t.dialog and t.parked is None) for t in tabs if not t.closed)

    def stamp(self, ms):
        return '%.3f' % ((ms - self.epoch_ms()) / 1000)

    def epoch_ms(self):
        return int(round(self.args.epoch * 1000))

    # ---- steps

    async def run_step(self, step):
        start = self.now
        for user in self.users.values():
            user.labels = set()
            user.lines = [a for a in step.actions if a.user == user.name]
            if user.lines:
                user.done = False
                user.parked.clear()
                user.task = asyncio.ensure_future(user.go())
                await user.parked.wait()
        end = None
        while self.error is None:
            blocked = [u for u in self.users.values() if not u.done]
            if blocked and all(u.waiting_kind and u.waiting_kind[0] == 'after' for u in blocked):
                raise Complaint('they wait for each other: %s' % '; '.join(
                    '%s for %s."%s"' % (u.name, u.waiting_kind[1], u.waiting_kind[2]) for u in blocked))
            if all(u.done for u in self.users.values()) and self.quiet():
                if step.wait is not None and end is None:
                    end = self.now + step.wait
                if end is None or self.now >= end:
                    break
            t = self.next_tag(end)
            if t is None:
                waiting = [u for u in self.users.values() if not u.done]
                if waiting:
                    raise Complaint('nothing more can happen, and %s' % '; '.join(
                        '%s waits at %s' % (u.name, self.current.get(u.name).text if self.current.get(u.name) else '?')
                        for u in waiting))
                raise Complaint('nothing more can happen, and the pages are not quiet: %s'
                                % (', '.join(self.path_of(h.req.url) for h in self.held if not h.poll)
                                   or ', '.join('%s %s' % (t.label, 'shows a dialog' if t.dialog else 'loads')
                                                for t in self.live_tabs() if t.loading or t.dialog)))
            await self.process_tag(t)
        for user in self.users.values():
            if user.task is not None and not user.task.done():
                user.task.cancel()
                try:
                    await user.task
                except BaseException:
                    pass
            user.task = None
        if self.error:
            raise Complaint(self.error)
        return start

    def cue(self, tab, text, at=None):
        if tab.video is not None:
            tab.video.cue([text, dt(self.now).strftime('page time %Y-%m-%dT%H:%M:%S.%f')[:-3] + 'Z'], at)

    # ---- records

    def complaint(self, e):
        return self.drv.complaint(e)

    def normalise(self, s):
        return s.replace(self.origin, 'localhost').replace(self.server_origin, 'localhost')

    def write(self, name, suffix, text):
        path = os.path.join(self.out, name + suffix)
        if text:
            with open(path, 'w', encoding='utf-8') as f:
                f.write(self.normalise(text))
        elif os.path.exists(path):
            os.unlink(path)

    async def record(self, step, error):
        for tab in self.live_tabs():
            page = tab.page
            if page is None:
                continue
            name = '%s.%s' % (step.name, tab.label)
            rec = step.tab(tab.label)
            lines = []
            for method, path, status in rec.requests:
                lines.append('%s %s %s' % (method, path, status if status is not None else '...'))
            for method, path, status, origin in rec.late:
                lines.append('%s %s %s (sent in %s)' % (method, path, status, origin))
            self.write(name, '.requests', ''.join(l + '\n' for l in lines))
            self.write(name, '.dialogs', ''.join(l + '\n' for l in rec.dialogs))
            self.write(name, '.console', ''.join(l + '\n' for l in rec.console))
            if tab.dialog is None:
                dump = await self.call(tab, page.evaluate(DUMP_JS, self.path_of(page.url)))
                self.write(name, '.page.html', dump)
            if self.screenshots and tab.dialog is None:
                await self.drv.shoot(page, '%s.%s.png' % (name, self.args.engine), self.screenshots)
        for h in self.held:
            if h.step is step and not h.tab.closed:
                step.timeline.append((h.sent, None, '%s: %s %s ...' % (h.tab.label, h.req.method, self.path_of(h.req.url))))
        lines = []
        for start, end, text in sorted(step.timeline, key=lambda e: (e[0], e[1] if e[1] is not None else 1 << 62, e[2])):
            lines.append('%s %s %s' % (self.stamp(start), self.stamp(end) if end is not None else '...', text))
        self.write(step.name, '.timeline', ''.join(l + '\n' for l in lines))
        self.write(step.name, '.error', error + '\n' if error else '')

    async def run(self):
        """The steps, each reported as it is done; then every browser
        closed, so that nothing of the run is left for the next; 'done'
        ends it.  Whether every step could be done."""
        os.makedirs(self.out, exist_ok=True)
        ok = True
        await self.server_clock(None)
        for step in self.steps:
            self.step = StepRecord(step.name)
            self.step_start = self.now
            error = None
            try:
                await self.run_step(step)
            except Complaint as e:
                error = str(e)
            except self.PlaywrightError as e:
                error = self.complaint(e)
            if error and self.error is None:
                self.error = error
            error = self.error
            for tab in self.live_tabs():
                if error and tab.user is getattr(self, 'failed_user', None):
                    self.cue(tab, '%s · %s: cannot be done: %s' % (step.name, tab.label, error.splitlines()[0]))
            try:
                await self.record(self.step, error)
            except self.PlaywrightError as e:
                error = error or self.complaint(e)
                self.write(step.name, '.error', error + '\n')
            except Complaint as e:
                error = error or str(e)
                self.write(step.name, '.error', error + '\n')
            self.step = None
            print(('fail %s' if error else 'step %s') % step.name, flush=True)
            if error:
                ok = False
                break
        for video in self.videos:
            video.end()
        for user in self.users.values():
            if user.context is not None:
                try:
                    await user.context.close()
                except self.PlaywrightError:
                    pass
                user.context = None
        for h in self.polls + self.held:
            if h.task is not None and not h.task.done():
                h.task.cancel()
        if self.recordings:
            self.drv.keep_videos(self.videos, self.recordings)
        self.closed_port.close()
        print('done', flush=True)
        return ok
# ------------------------------------------------------------- the driver

class Driver:
    """The engine, started once, and the runs done through it."""

    def __init__(self, args, playwright_error):
        self.args = args
        self.PlaywrightError = playwright_error
        self.browser = None

    def complaint(self, e):
        """What Playwright said, less its call log, which narrates what the
        driver did."""
        lines = []
        for line in str(e).splitlines():
            if line.strip().startswith('Call log'):
                break
            lines.append(line.rstrip())
        while lines and not lines[-1]:
            lines.pop()
        return '\n'.join(lines)

    async def launch(self, p):
        """The engine; a failure is said plainly, since what urt shows of
        this is the first lines, and a traceback's are the least telling."""
        try:
            if self.args.engine == 'chromium':
                # Chromium keeps renderer memory under /dev/shm unless told
                # not to, and a build sandbox (nix's) has next to none
                # there, which closes the page before the first step.
                # Smooth scrolling (the keyboard's) would land in wall time.
                self.browser = await p.chromium.launch(args=['--disable-dev-shm-usage', '--disable-smooth-scrolling'])
            elif self.args.engine == 'firefox':
                # Firefox fetches a page's favicon from outside the page,
                # where Playwright does not see it; the server would.  And
                # smooth scrolling (the keyboard's) would land in wall time.
                self.browser = await p.firefox.launch(firefox_user_prefs={'browser.chrome.site_icons': False,
                                                                          'general.smoothScroll': False})
            else:
                self.browser = await p.webkit.launch()
        except self.PlaywrightError as e:
            print('%s does not start: %s' % (self.args.engine, self.complaint(e)), file=sys.stderr)
            return False
        return True

    async def shoot(self, page, file, directory):
        """A screenshot of the whole page, as the engine draws it, nothing
        moved or hidden for it (the caret is left alone: hiding it leaves
        an empty style attribute on every field, which the page record
        would show); taken again until two in a row agree, since WebKit
        under load has handed over a frame from before the last change.
        A page that is gone has no picture."""
        try:
            last = None
            for _ in range(8):
                png = await page.screenshot(full_page=True, scale='css', caret='initial')
                if png == last:
                    break
                last = png
        except self.PlaywrightError:
            return
        os.makedirs(directory, exist_ok=True)
        with open(os.path.join(directory, file), 'wb') as f:
            f.write(last)

    def keep_videos(self, videos, directory):
        """The run's videos under their names, each with its cues as
        WebVTT, and an index.html playing every video in the directory."""
        for video in videos:
            try:
                os.replace(video.path, os.path.join(directory, video.name + '.webm'))
            except OSError as e:
                print('urt-browse: no video for %s: %s' % (video.name, e), file=sys.stderr)
                continue
            with open(os.path.join(directory, video.name + '.vtt'), 'w', encoding='utf-8') as f:
                f.write('WEBVTT\n\n')
                for start, end, lines in video.cues:
                    f.write('%s --> %s\n%s\n\n' % (vtt_time(start), vtt_time(end if end is not None else start),
                                                   '\n'.join(vtt_text(l) for l in lines)))
        write_index(directory)

    async def run_one(self, url, run_dir, out, screenshots, recordings):
        steps, setup, order, complaints = read_run(run_dir)
        if complaints:
            for c in complaints:
                print(c, file=sys.stderr)
            print('done', flush=True)
            return False
        run = Run(self, url, run_dir, out, steps, setup, order, screenshots, recordings)
        return await run.run()

    async def main(self, async_playwright):
        async with async_playwright() as p:
            if not await self.launch(p):
                return 2
            if not self.args.serve:
                ok = await self.run_one(self.args.url, self.args.run, self.args.out, self.args.screenshots,
                                        self.args.recordings)
                await self.browser.close()
                return 0 if ok else 1
            loop = asyncio.get_running_loop()
            while True:
                line = await loop.run_in_executor(None, sys.stdin.readline)
                if not line:
                    break
                words = shlex.split(line)
                options = dict(w.split('=', 1) for w in words[4:] if '=' in w)
                if len(words) < 4 or words[0] != 'run' or len(options) != len(words) - 4 \
                        or set(options) - {'screenshots', 'recordings'}:
                    print('urt-browse: not a run: %s' % line.rstrip(), file=sys.stderr)
                    print('done', flush=True)
                    continue
                await self.run_one(words[1], words[2], words[3], options.get('screenshots'), options.get('recordings'))
            await self.browser.close()
        return 0


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument('--engine', choices=['chromium', 'firefox', 'webkit'], default='chromium')
    ap.add_argument('--epoch', type=float, default=946684800)
    ap.add_argument('--timeout', type=float, default=10)
    ap.add_argument('--screenshots', default=None)
    ap.add_argument('--recordings', default=None)
    ap.add_argument('--check', action='store_true')
    ap.add_argument('--serve', action='store_true')
    ap.add_argument('--help', action='store_true')
    ap.add_argument('rest', nargs='*')
    args = ap.parse_args()
    if args.help:
        print(__doc__.strip())
        return 0
    if args.check:
        if len(args.rest) != 1:
            print('usage: urt-browse --check RUN', file=sys.stderr)
            return 2
        _, _, _, complaints = read_run(args.rest[0])
        for c in complaints:
            print(c)
        return 1 if complaints else 0
    if args.serve:
        if args.rest or args.screenshots or args.recordings:
            print('usage: urt-browse --serve [--engine chromium|firefox|webkit] [--epoch SECONDS] [--timeout SECONDS]',
                  file=sys.stderr)
            return 2
    elif len(args.rest) != 3:
        print('usage: urt-browse [--engine chromium|firefox|webkit] [--epoch SECONDS] [--timeout SECONDS] '
              '[--screenshots DIR] [--recordings DIR] URL RUN OUT', file=sys.stderr)
        return 2
    else:
        args.url, args.run, args.out = args.rest
        _, _, _, complaints = read_run(args.run)
        if complaints:
            for c in complaints:
                print(c, file=sys.stderr)
            return 2
    # Playwright is imported here so that --check needs only python3.
    from playwright.async_api import Error as PlaywrightError, async_playwright
    return asyncio.run(Driver(args, PlaywrightError).main(async_playwright))


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as e:
        # The gist first, where urt shows it; the traceback after.
        print('urt-browse: %s: %s' % (type(e).__name__, str(e).splitlines()[0] if str(e) else ''), file=sys.stderr)
        raise
