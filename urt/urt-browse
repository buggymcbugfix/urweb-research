# What a verb takes as its time when the action gives none: how long the
# act lasts (for until, how long at most), before the context's say.
DEFAULT_TIMES = {
    'click': 400, 'dblclick': 400, 'hover': 400, 'check': 400, 'uncheck': 400,
    'drag': 1000, 'swipe': 300, 'wheel': 300, 'type': 150, 'fill': 200, 'press': 100,
    'select': 500, 'focus': 100, 'tab': 300, 'dialog': 1000,
    'open': 0, 'back': 0, 'forward': 0, 'reload': 0, 'close': 0, 'until': 10000,
}
DEFAULT_RTT = 100


def usage(verb):
    pos, req, opt, flags, time_ = VERBS[verb]
    parts = [verb] + list(pos) + ['(%s=...)' % r for r in req] + ['[%s=...]' % o for o in opt] + ['[%s]' % f for f in flags]
    if time_:
        parts.append('[T]')
    if verb in PAGE_ACTIONS:
        parts += ['[target=NAME]', '[async]']
    return ' '.join(parts)


class Action:
    """One line of a step, read: the user, the verb, its positional
    arguments (texts, or a label's name), its named parameters, flags,
    the time it was given (ms, or None), and where it was written."""

    def __init__(self, user, verb, args, named, flags, time_, where, text):
        self.user, self.verb, self.args, self.named, self.flags, self.time = user, verb, args, named, flags, time_
        self.where, self.text = where, text

    def __repr__(self):
        return '<%s: %s>' % (self.user, self.text)


def parse_action(user, words, where, line):
    """One action from its words (after USER:); raise Complaint."""
    if not words or words[0].kind != 'word' or not words[0].bare:
        raise Complaint('%s: takes an action, as in: %s: open /Shop/main [target=1]' % (user, user))
    verb = words[0].text
    if verb not in VERBS:
        raise Complaint("'%s' is not an action; the actions are %s" % (verb, ', '.join(sorted(VERBS))))
    pos, req, opt, flags, takes_time = VERBS[verb]
    if verb in PAGE_ACTIONS:
        opt = opt + ('target',)
        flags = flags + ('async',)
    args, named, flagset, time_ = [], {}, set(), None
    for w in words[1:]:
        if w.kind in ('opt', 'req'):
            inner = w.text.strip()
            t = parse_time(inner)
            if w.kind == 'opt' and t is not None:
                if not takes_time:
                    raise Complaint('%s takes no time' % verb)
                if time_ is not None:
                    raise Complaint('%s is given two times' % verb)
                time_ = t
                continue
            name, eq, value = inner.partition('=')
            if not eq:
                if w.kind == 'opt' and name in flags:
                    flagset.add(name)
                    continue
                if TIME.match(name.replace(' ', '')) or re.match(r'^\d', name):
                    raise Complaint("'[%s]' is not a time: a number and its unit, as in [500ms], [2s], [1min]" % inner)
                raise Complaint("'%s' is neither a flag nor a parameter of %s: %s" % (inner, verb, usage(verb)))
            allowed = req if w.kind == 'req' else opt
            if name not in allowed:
                if name in opt:
                    raise Complaint('%s is optional for %s, in brackets: %s' % (name, verb, usage(verb)))
                if name in req:
                    raise Complaint('%s is required for %s, in parentheses: %s' % (name, verb, usage(verb)))
                raise Complaint('%s takes no %s: %s' % (verb, name, usage(verb)))
            if name in named:
                raise Complaint('%s is given twice' % name)
            named[name] = unquote(value)
        elif w.kind == 'label':
            args.append(('label', w.text))
        elif w.kind == 'ref':
            args.append(('ref', w.user, w.text))
        else:
            args.append(w.text)
    for r in req:
        if r not in named:
            raise Complaint('%s takes (%s=...): %s' % (verb, r, usage(verb)))
    a = Action(user, verb, args, named, flagset, time_, where, line)
    check_shape(a)
    return a


def check_shape(a):
    """What an action's arguments have to be, verb by verb; raise
    Complaint."""
    verb, args = a.verb, a.args
    strings = all(isinstance(x, str) for x in args)
    if not strings and verb not in ('label', 'after'):
        raise Complaint('double quotes are for labels; text and locators take single quotes')

    def need(n):
        if len(args) != n or not strings:
            raise Complaint('%s takes %s' % (verb, usage(verb)))

    if verb == 'open':
        need(1)
        if not args[0].startswith('/'):
            raise Complaint("open takes a path starting with /, not '%s'" % args[0])
    elif verb in ('click', 'dblclick', 'hover', 'focus', 'check', 'uncheck', 'until'):
        need(1)
    elif verb in ('drag',):
        need(2)
    elif verb == 'swipe':
        need(1)
    elif verb == 'wheel':
        need(2)
        try:
            float(args[0]), float(args[1])
        except ValueError:
            raise Complaint("wheel takes two numbers of pixels, right and down, not '%s %s'" % (args[0], args[1]))
    elif verb in ('fill', 'type'):
        need(2)
    elif verb == 'press':
        need(1)
    elif verb == 'select':
        if len(args) < 2 or not strings:
            raise Complaint('select takes a locator and the values')
    elif verb in ('back', 'forward', 'reload', 'close', 'quit'):
        need(0)
    elif verb == 'tab':
        need(1)
        if not NAME_PART.match(args[0]):
            raise Complaint("'%s' is not a tab's name: letters, digits, _ and -" % args[0])
    elif verb == 'dialog':
        if not strings or not ((len(args) == 1 and args[0] in ('accept', 'dismiss')) or (len(args) == 2 and args[0] == 'answer')):
            raise Complaint("dialog takes 'accept', 'dismiss' or 'answer TEXT'")
    elif verb == 'wait':
        if len(args) != 1 or not strings or parse_time(args[0]) is None:
            raise Complaint('wait takes a time, a number and its unit: 500ms, 2s, 1min')
        a.time = parse_time(args[0])
    elif verb == 'label':
        if len(args) != 1 or not isinstance(args[0], tuple) or args[0][0] != 'label':
            raise Complaint('label takes a name in double quotes: label "typing"')
    elif verb == 'after':
        if len(args) != 1 or not isinstance(args[0], tuple) or args[0][0] != 'ref':
            raise Complaint('after takes a user\'s label: after Alice."typing"; for a time, wait')
        if args[0][1] == a.user:
            raise Complaint("%s waits for a label of their own" % a.user)
    for p in ('at', 'from', 'to'):
        if p in a.named and not POSITION.match(a.named[p]):
            raise Complaint("%s=%s is not a position: X,Y, each a percentage of the element's box or pixels "
                            "from its top-left corner, as in 50%%,80%% or 12,40" % (p, a.named[p]))
    if 'target' in a.named and not NAME_PART.match(a.named['target']):
        raise Complaint("'%s' is not a tab's name: letters, digits, _ and -" % a.named['target'])


class Step:
    """A step as read: its name, its actions in the order written (each
    user's in their order), and the time to let pass at its end."""

    def __init__(self, name):
        self.name = name
        self.actions = []
        self.wait = None


def read_step(name, text, file, complaints, users):
    """One step file; its complaints go on complaints, as 'FILE:LINE:
    ...', and every user named on users."""
    step = Step(name)
    block = None
    lines = text.splitlines()
    last_line = 0
    for n, raw in enumerate(lines, 1):
        if raw.strip() and not raw.strip().startswith('#'):
            last_line = n
    for n, raw in enumerate(lines, 1):
        where = '%s:%d' % (file, n)
        stripped = raw.strip()
        if not stripped or stripped.startswith('#'):
            continue
        try:
            if step.wait is not None:
                raise Complaint('a step ends with its wait for everyone; nothing comes after it')
            if raw[0] == '\t':
                if block is None:
                    raise Complaint('an indented line belongs to a block, which starts with a line USER: alone')
                body = raw[1:]
                if body[:1] in (' ', '\t') and body.strip():
                    raise Complaint('a block\'s lines are indented with one tab')
                words = split_words(body)
                step.actions.append(parse_action(block, words, where, body.strip()))
                continue
            if raw[0] == ' ':
                raise Complaint("a block's lines are indented with a tab, not blanks")
            block = None
            words = split_words(raw)
            first = words[0]
            if first.kind == 'word' and re.match(r'^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+:$', first.text):
                raise Complaint("lines name the user alone now, not the tab: %s open /Shop/main [target=%s]"
                                % (first.text.split('.')[0] + ':', first.text.split('.')[1][:-1]))
            if first.kind == 'word' and first.bare and first.text.endswith(':'):
                user = first.text[:-1]
                if not NAME_PART.match(user):
                    raise Complaint("'%s' is not a user's name: letters, digits, _ and -" % user)
                users.add(user)
                if len(words) == 1:
                    block = user
                    continue
                rest = raw.strip()[len(first.text):].strip()
                step.actions.append(parse_action(user, words[1:], where, rest))
                continue
            if first.kind == 'word' and first.bare and first.text == 'wait':
                if len(words) != 2 or words[1].kind != 'word' or parse_time(words[1].text) is None:
                    raise Complaint('wait for everyone takes a time, a number and its unit: wait 1min')
                if n != last_line:
                    raise Complaint('wait for everyone is a step\'s last line; a user\'s pause is USER: wait T')
                step.wait = parse_time(words[1].text)
                continue
            raise Complaint('a line starts with the user it is for, USER:, as in: Alice: open /Shop/main [target=1]')
        except Complaint as e:
            complaints.append('%s: %s' % (where, e))
    if not step.actions and step.wait is None and not any(c.startswith(file + ':') for c in complaints):
        complaints.append('%s: no action; a step does something, as in: Alice: open /Shop/main [target=1]' % file)
    return step


def check_steps(steps, complaints):
    """What follows from the steps taken together, each user's lines in
    order: the tabs (a page action needs a tab in front, [target=NAME]
    names a tab that is not open, tab NAME one that is open and not in
    front), and the labels (each defined once per step, after naming one
    another user defines in the same step)."""
    tabs = {}       # user -> [names], in the order of opening
    front = {}      # user -> name or None
    for step in steps:
        labels = {}
        for a in step.actions:
            if a.verb == 'label':
                key = (a.user, a.args[0][1])
                if key in labels:
                    complaints.append('%s: %s."%s" is defined twice in this step' % (a.where, a.user, a.args[0][1]))
                labels[key] = a
        for a in step.actions:
            u = a.user
            ts = tabs.setdefault(u, [])
            try:
                if a.verb == 'after':
                    _, who, name = a.args[0]
                    if (who, name) not in labels:
                        raise Complaint('no line of this step is label "%s" for %s' % (name, who))
                target = a.named.get('target')
                if target is not None:
                    if target in ts:
                        raise Complaint('%s has a tab %s open already' % (u, target))
                    if a.verb != 'open' and front.get(u) is None:
                        raise Complaint('%s has no tab in front to %s in; open one first, as in: %s: open /Shop/main '
                                        '[target=1]' % (u, a.verb, u))
                    ts.append(target)
                    front[u] = target
                elif a.verb in PAGE_ACTIONS and front.get(u) is None:
                    raise Complaint('%s has no tab in front to %s; a tab is opened with [target=NAME], as in: '
                                    '%s: open /Shop/main [target=1]' % (u, a.verb if a.verb == 'close' else a.verb + ' in', u))
                if a.verb == 'tab':
                    name = a.args[0]
                    if name not in ts:
                        raise Complaint('%s has no tab %s open' % (u, name))
                    if front.get(u) == name:
                        raise Complaint('%s is in front already' % name)
                    front[u] = name
                elif a.verb == 'close' and target is None:
                    i = ts.index(front[u])
                    ts.pop(i)
                    front[u] = ts[i] if i < len(ts) else ts[i - 1] if ts else None
                elif a.verb == 'quit':
                    ts.clear()
                    front[u] = None
            except Complaint as e:
                complaints.append('%s: %s' % (a.where, e))


# --------------------------------------------------------------- contexts

# What a user's browser is set up with unless the context says otherwise:
# Playwright's options for a context, by its names.  The user agent so
# that the server sees the same one from every engine, the locale and the
# time zone so that nothing of the host's shows in a page, the window
# since the engines' defaults differ.
CONTEXT_DEFAULTS = {'user_agent': 'urt', 'viewport': {'width': 1024, 'height': 768}, 'device_scale_factor': 1,
                    'locale': 'en-US', 'timezone_id': 'UTC'}

CONTEXT_CHOICES = {'color_scheme': ('light', 'dark', 'no-preference'),
                   'reduced_motion': ('reduce', 'no-preference'),
                   'forced_colors': ('active', 'none'),
                   'has_touch': ('yes', 'no')}

CONTEXT_OPTIONS = ('viewport', 'device_scale_factor', 'color_scheme', 'reduced_motion', 'forced_colors',
                   'locale', 'timezone_id', 'has_touch', 'user_agent')


def parse_option(option, value):
    """One of Playwright's context options with its value from a context
    line; raise Complaint, or return the value as Playwright takes it."""
    if option == 'viewport':
        m = re.match(r'^([1-9]\d*)x([1-9]\d*)$', value)
        if not m:
            raise Complaint("viewport takes WxH, the window in pixels, as in 1024x768, not '%s'" % value)
        return {'width': int(m.group(1)), 'height': int(m.group(2))}
    if option == 'device_scale_factor':
        if not re.match(r'^\d+(\.\d+)?$', value) or float(value) <= 0:
            raise Complaint("device_scale_factor takes a number above 0, not '%s'" % value)
        return float(value)
    if option in CONTEXT_CHOICES:
        if value not in CONTEXT_CHOICES[option]:
            choices = CONTEXT_CHOICES[option]
            raise Complaint("%s takes %s, not '%s'" % (option, ' or '.join([', '.join(choices[:-1]), choices[-1]]), value))
        return value == 'yes' if option == 'has_touch' else value
    if not value:
        raise Complaint('%s takes a value' % option)
    return value


# How a hidden tab's timers are held back unless the context says
# otherwise: Chrome's, every timer on whole seconds, and after five minutes
# hidden, a chain of them (each set from the one before, five deep) on
# whole minutes.  [after, every, chained], in ms.
DEFAULT_THROTTLE = [[0, 1000, False], [300000, 60000, True]]


class Setup:
    """How a run's users are set up, from its context file: the tie order
    of the users, whether tasks due at a time come before or after the
    requests then, and per user (None for everyone) Playwright's options,
    the verbs' times, the round trip and the throttling of a hidden tab's
    timers."""

    def __init__(self):
        self.order = None
        self.tasks = 'first'
        self.options = {None: {}}
        self.times = {None: {}}
        self.rtt = {None: DEFAULT_RTT}
        self.throttle = {None: DEFAULT_THROTTLE}

    def options_of(self, user):
        o = dict(CONTEXT_DEFAULTS)
        o.update(self.options[None])
        o.update(self.options.get(user, {}))
        return o

    def time_of(self, user, verb):
        return self.times.get(user, {}).get(verb, self.times[None].get(verb, DEFAULT_TIMES.get(verb, 0)))

    def rtt_of(self, user):
        return self.rtt.get(user, self.rtt[None])

    def throttle_of(self, user):
        return self.throttle.get(user, self.throttle[None])


def read_context(text, file, complaints):
    """A run's context file: lines OPTION VALUE, those before any line
    [USER] for every user, those after it for that user."""
    setup = Setup()
    user = None
    seen = {None: set()}
    throttles = {}
    for n, raw in enumerate(text.splitlines(), 1):
        where = '%s:%d' % (file, n)
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        try:
            m = re.match(r'^\[([^\]]*)\]$', line)
            if m:
                user = m.group(1)
                if not NAME_PART.match(user):
                    raise Complaint("[%s] is not a user's name: letters, digits, _ and -" % user)
                if user in seen:
                    raise Complaint('[%s] is given twice' % user)
                seen[user] = set()
                setup.options[user], setup.times[user] = {}, {}
                continue
            words = split_words(line)
            if any(w.kind != 'word' for w in words):
                raise Complaint('a context line is OPTION VALUE, text in single quotes')
            option, values = words[0].text, [w.text for w in words[1:]]
            if option in seen[user] and option != 'throttle':
                raise Complaint('%s is given twice%s' % (option, ' for %s' % user if user else ''))
            seen[user].add(option)
            if option == 'throttle':
                tiers = throttles.setdefault(user, [])
                if values == ['none']:
                    if tiers:
                        raise Complaint('throttle none goes alone')
                    tiers.append(None)
                    continue
                if tiers == [None]:
                    raise Complaint('throttle none goes alone')
                if len(values) not in (2, 3) or len(values) == 3 and values[2] != 'chained' \
                        or parse_time(values[0]) is None or not parse_time(values[1] or ''):
                    raise Complaint('throttle takes AFTER EVERY [chained], two times: once a tab has been hidden '
                                    'for AFTER, its timers wait for the next multiple of EVERY (only those set '
                                    'from a timer five deep, with chained); or none')
                after = parse_time(values[0])
                if any(t[0] == after for t in tiers):
                    raise Complaint('throttle %s is given twice%s' % (values[0], ' for %s' % user if user else ''))
                tiers.append([after, parse_time(values[1]), len(values) == 3])
                continue
            if option in ('order', 'tasks'):
                if user is not None:
                    raise Complaint('%s is the run\'s, not a user\'s: it goes before the first [USER]' % option)
                if option == 'order':
                    if not values or not all(NAME_PART.match(v) for v in values) or len(set(values)) != len(values):
                        raise Complaint('order names every user once, first to last: order Alice Bernd')
                    setup.order = values
                else:
                    if values not in (['first'], ['last']):
                        raise Complaint("tasks takes 'first' or 'last': whether the server's tasks due at a time "
                                        "come before or after the requests arriving then")
                    setup.tasks = values[0]
            elif option in CONTEXT_OPTIONS:
                if len(values) != 1:
                    raise Complaint('%s takes one value' % option)
                setup.options[user][option] = parse_option(option, values[0])
            elif option == 'rtt' or option in DEFAULT_TIMES:
                if len(values) != 1 or parse_time(values[0]) is None:
                    raise Complaint('%s takes a time, a number and its unit: 150ms, 2s' % option)
                if option == 'rtt':
                    setup.rtt[user] = parse_time(values[0])
                else:
                    setup.times[user][option] = parse_time(values[0])
            else:
                raise Complaint("'%s' is not an option; the options are order, tasks, rtt, throttle, the verbs' "
                                "times (%s), and %s" % (option, ', '.join(sorted(DEFAULT_TIMES)), ', '.join(CONTEXT_OPTIONS)))
        except Complaint as e:
            complaints.append('%s: %s' % (where, e))
    # A user's throttle lines take the place of everyone's.
    for who, tiers in throttles.items():
        setup.throttle[who] = [] if tiers == [None] else sorted(tiers)
    return setup


def read_run(run_dir):
    """A run's steps and setup: (steps, setup, users, complaints), the
    steps from run_dir/interaction in the order of their names, the setup
    from run_dir/context; the users in their tie order."""
    complaints, users = [], set()
    steps_dir = os.path.join(run_dir, 'interaction')
    try:
        names = sorted(f[:-5] for f in os.listdir(steps_dir) if f.endswith('.step'))
    except OSError as e:
        return [], Setup(), [], ['%s: %s' % (steps_dir, e.strerror)]
    steps = []
    for name in names:
        file = name + '.step'
        try:
            with open(os.path.join(steps_dir, file), encoding='utf-8') as f:
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            complaints.append('%s: %s' % (file, getattr(e, 'strerror', None) or e))
            continue
        steps.append(read_step(name, text, file, complaints, users))
    check_steps(steps, complaints)
    setup = Setup()
    path = os.path.join(run_dir, 'context')
    if os.path.exists(path):
        try:
            with open(path, encoding='utf-8') as f:
                setup = read_context(f.read(), 'context', complaints)
        except (OSError, UnicodeDecodeError) as e:
            complaints.append('context: %s' % (getattr(e, 'strerror', None) or e))
    for user in sorted(set(setup.options) - {None}):
        if user not in users:
            complaints.append("context: [%s] is set up, and no step names %s" % (user, user))
    if setup.order is not None:
        if set(setup.order) != users:
            missing, extra = sorted(users - set(setup.order)), sorted(set(setup.order) - users)
            complaints.append('context: order names every user of the steps once%s%s'
                              % ('; it leaves out %s' % ', '.join(missing) if missing else '',
                                 '; no step names %s' % ', '.join(extra) if extra else ''))
        order = list(setup.order)
    elif len(users) > 1:
        complaints.append('context: a run with %d users says in what order what they do at the same time is done: '
                          'order %s' % (len(users), ' '.join(sorted(users))))
        order = sorted(users)
    else:
        order = sorted(users)
    for f in sorted(os.listdir(run_dir)) if os.path.isdir(run_dir) else []:
        if f.endswith('.context'):
            complaints.append("%s: a user's browser is set up in the run's context file now, under a line [%s]"
                              % (f, f[:-8]))

    def where(c):
        m = re.match(r'^([^:]*)(?::(\d+))?:', c)
        return (m.group(1) == 'context', m.group(1), int(m.group(2) or 0)) if m else (True, c, 0)
    complaints.sort(key=where)
    return steps, setup, order, complaints

# -------------------------------------------------------------- recording

class Recording:
    """One tab's video, from its opening to its closing: where Playwright
    writes it, what it is to be called, when it started, and the cues:
    [start, end, lines], the seconds from the start."""

    def __init__(self, name, path, started):
        self.name = name
        self.path = path
        self.started = started
        self.cues = []

    def cue(self, lines, at=None):
        now = max(0.0, time.monotonic() - self.started) if at is None else at
        if self.cues:
            self.cues[-1][1] = now
        self.cues.append([now, None, lines])

    def end(self):
        if self.cues and self.cues[-1][1] is None:
            self.cues[-1][1] = max(self.cues[-1][0], time.monotonic() - self.started)


def vtt_time(seconds):
    ms = int(round(seconds * 1000))
    return '%02d:%02d:%02d.%03d' % (ms // 3600000, ms // 60000 % 60, ms // 1000 % 60, ms % 1000)


def vtt_text(s):
    return s.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')


def read_vtt(path):
    """The cues of a WebVTT file as this program writes them: a list of
    (start, end, lines), the times in seconds."""
    cues = []
    with open(path, encoding='utf-8') as f:
        blocks = f.read().split('\n\n')
    for block in blocks[1:]:
        lines = block.strip('\n').split('\n')
        m = re.match(r'^(\d+):(\d+):(\d+)\.(\d+) --> (\d+):(\d+):(\d+)\.(\d+)$', lines[0]) if lines else None
        if not m:
            continue
        t = [int(x) for x in m.groups()]
        cues.append((t[0] * 3600 + t[1] * 60 + t[2] + t[3] / 1000, t[4] * 3600 + t[5] * 60 + t[6] + t[7] / 1000,
                     [html.unescape(l) for l in lines[1:]]))
    return cues


