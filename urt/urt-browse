    # verb:      (positional, required, optional, flags, time)
    'open':     (('PATH',), (), (), (), True),
    'click':    (('L',), (), ('at',), (), True),
    'dblclick': (('L',), (), ('at',), (), True),
    'hover':    (('L',), (), ('at',), (), True),
    'focus':    (('L',), (), (), (), True),
    'check':    (('L',), (), (), (), True),
    'uncheck':  (('L',), (), (), (), True),
    'drag':     (('L1', 'L2'), (), ('from', 'to'), (), True),
    'swipe':    (('L',), ('from', 'to'), (), (), True),
    'wheel':    (('DX', 'DY'), (), (), (), True),
    'fill':     (('L', 'TEXT'), (), (), (), True),
    'type':     (('L', 'TEXT'), (), (), (), True),
    'press':    (('KEY',), (), ('on',), (), True),
    'select':   (('L', 'VALUE...'), (), (), (), True),
    'back':     ((), (), (), (), True),
    'forward':  ((), (), (), (), True),
    'reload':   ((), (), (), (), True),
    'close':    ((), (), (), (), True),
    'tab':      (('NAME',), (), (), (), True),
    'quit':     ((), (), (), (), False),
