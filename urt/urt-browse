# The page as HTML, from the DOM as the browser has it: one element per
# line, indented; scripts, styles and handlers left out; the live value
# of every field in; `hidden` on what is not shown (nothing in the head
# is), `autofocus` on the field that has the focus, when that is a field
# one types into.  Called with the page's path, which goes into a comment
# after the doctype.
DUMP_JS = r"""
(path) => {
    const out = ['<!DOCTYPE html>', '<!-- ' + path + ' -->'];
    const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const escAttr = s => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
    const voids = new Set(['area','base','br','col','embed','hr','img','input','link','meta','source','track','wbr']);
    const notTyped = new Set(['button','checkbox','radio','file','color','range','hidden','image','submit','reset']);
    const left = new Set(['script', 'style', 'noscript', 'urt-cursor']);   // urt-cursor: the pointer drawn for a recording
    function text(n) { return n.data.replace(/\s+/g, ' ').trim(); }
    function typedInto(e) {
        const tag = e.tagName.toLowerCase();
        if (tag === 'textarea') { return true; }
        if (tag === 'input') { return !notTyped.has((e.getAttribute('type') || 'text').toLowerCase()); }
        return e.isContentEditable;
    }
    function attrs(e, inHead) {
        const live = {};
        const tag = e.tagName.toLowerCase();
        if (tag === 'input') {
            const t = (e.getAttribute('type') || 'text').toLowerCase();
            if (t === 'checkbox' || t === 'radio') { live.checked = e.checked ? '' : null; }
            else if (t !== 'submit' && t !== 'button' && t !== 'reset' && t !== 'image') { live.value = e.value; }
        } else if (tag === 'textarea') { live.value = e.value; }
        else if (tag === 'select') { live.value = e.value; }
        else if (tag === 'option') { live.selected = e.selected ? '' : null; }
        let s = '';
        const seen = new Set();
        for (const a of e.attributes) {
            const name = a.name;
            if (/^on/i.test(name)) { continue; }
            seen.add(name);
            let v = a.value;
            if (name in live) { v = live[name]; if (v === null) { continue; } }
            s += v === '' && (name === 'checked' || name === 'selected' || name === 'disabled' || name === 'readonly')
                ? ' ' + name : ' ' + name + '="' + escAttr(v) + '"';
        }
        for (const name in live) {
            if (seen.has(name) || live[name] === null) { continue; }
            s += live[name] === '' && name !== 'value' ? ' ' + name : ' ' + name + '="' + escAttr(live[name]) + '"';
        }
        if (e === document.activeElement && typedInto(e) && !seen.has('autofocus')) { s += ' autofocus'; }
        if (!inHead && tag !== 'html' && e.parentNode && e.parentNode !== document && typeof e.checkVisibility === 'function'
            && !e.checkVisibility({ visibilityProperty: true }) && !seen.has('hidden')) { s += ' hidden'; }
        return s;
    }
    function dump(n, depth, inHead) {
        const pad = '  '.repeat(depth);
        if (n.nodeType === 3) { const t = text(n); if (t) { out.push(pad + esc(t)); } return; }
        if (n.nodeType === 8) { out.push(pad + '<!-- ' + text(n) + ' -->'); return; }
        if (n.nodeType !== 1) { return; }
        const tag = n.tagName.toLowerCase();
        if (left.has(tag)) { return; }
        inHead = inHead || tag === 'head';
        const kids = Array.from(n.childNodes).filter(k => k.nodeType === 1 ? !left.has(k.tagName.toLowerCase())
                                                       : k.nodeType === 3 ? text(k) !== '' : k.nodeType === 8);
        const open = '<' + tag + attrs(n, inHead) + '>';
        if (voids.has(tag)) { out.push(pad + open); return; }
        if (kids.length === 0) { out.push(pad + open + '</' + tag + '>'); return; }
        if (kids.every(k => k.nodeType === 3)) { out.push(pad + open + kids.map(k => esc(text(k))).join(' ') + '</' + tag + '>'); return; }
        out.push(pad + open);
        for (const k of kids) { dump(k, depth + 1, inHead); }
        out.push(pad + '</' + tag + '>');
    }
    dump(document.documentElement, 0, false);
    return out.join('\n') + '\n';
}
"""


# A pointer drawn into the page while it is recorded, since a headless
# engine draws none: Playwright's actions send the page real mouse
# events, and these move an element over the page with them, pressed
# between mousedown and mouseup.  A name no locator a run uses matches,
# outside the body so that `body > *` matches what it matched,
# pointer-events none so that it is never what is under the pointer,
# and the dump leaves it out.  It appears at the page's first mouse
# event: a page loaded under a still pointer gets none, and the driver
# sends none for it, since a move would fire the page's mouseover.
CURSOR_JS = r"""
(() => {
    const arrow = 'data:image/svg+xml,' + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="28" viewBox="0 0 20 28">'
        + '<path d="M2 2 L2 22 L7 17.5 L11 26 L14.5 24.5 L10.5 16 L17 16 Z" fill="#000" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/>'
        + '</svg>');
    let el = null;
    function cursor() {
        if (!el && document.documentElement) {
            el = document.createElement('urt-cursor');
            el.style.cssText = 'position:fixed;left:0;top:0;width:20px;height:28px;display:block;pointer-events:none;'
                + 'z-index:2147483647;background:url(' + arrow + ') no-repeat;';
            document.documentElement.appendChild(el);
        }
        return el;
    }
    function move(e) {
        const c = cursor();
        if (c) { c.style.transform = 'translate(' + (e.clientX - 2) + 'px,' + (e.clientY - 2) + 'px)'; }
    }
    function press(e, down) {
        move(e);
        if (el) { el.style.filter = down ? 'drop-shadow(0 0 5px #e22)' : ''; }
    }
    window.addEventListener('mousemove', move, true);
    window.addEventListener('mousedown', e => press(e, true), true);
    window.addEventListener('mouseup', e => press(e, false), true);
})();
"""


# ------------------------------------------------------------------ words

class Complaint(Exception):
    """A step that cannot be done, or a line that cannot be read, with the
    reason."""


NAME_PART = re.compile(r'^[A-Za-z0-9_-]+$')
POSITION = re.compile(r'^(-?\d+(?:\.\d+)?)(%?),(-?\d+(?:\.\d+)?)(%?)$')
TIME = re.compile(r'^(\d+(?:\.\d+)?)(ms|s|min|h|d)$')
UNITS = {'ms': 1, 's': 1000, 'min': 60000, 'h': 3600000, 'd': 86400000}


def parse_time(word):
    """A time, a number and its unit with nothing between (500ms, 2s, 1.5s,
    3min, 1h, 2d), in milliseconds; or None."""
    m = TIME.match(word)
    if not m:
        return None
    return int(round(float(m.group(1)) * UNITS[m.group(2)]))


def show_time(ms):
    """A time as a step would write it."""
    for unit in ('d', 'h', 'min', 's'):
        if ms and ms % UNITS[unit] == 0:
            return '%d%s' % (ms // UNITS[unit], unit)
    return '%dms' % ms


class Word:
    """One word of a line: kind 'word' (its text, quoted parts and all;
    bare when no part of it was quoted), 'label' ("NAME"), 'ref'
    (USER."NAME": user and text), 'opt' ([...], its inside as text) or
    'req' ((...))."""

    def __init__(self, kind, text, bare=False, user=None):
        self.kind, self.text, self.bare, self.user = kind, text, bare, user

    def __repr__(self):
        return '%s:%r' % (self.kind, self.text)


def split_words(line):
    """The words of a line, as Word: single quotes and backslashes as a
    shell has them, for text and locators; double quotes for labels only,
    "NAME" or USER."NAME"; a word in brackets or parentheses, its brackets
    unquoted, is a parameter, and may hold quoted text with blanks.  Raise
    Complaint."""
    words, i, n = [], 0, len(line)
    while i < n:
        if line[i] in ' \t':
            i += 1
            continue
        if line[i] == '#' and (i == 0 or line[i - 1] in ' \t'):
            break                       # a comment to the end of the line
        if line[i] in '[(':
            close = ']' if line[i] == '[' else ')'
            j, inner, quote = i + 1, [], None
            while j < n:
                c = line[j]
                if quote:
                    if c == quote:
                        quote = None
                    inner.append(c)
                elif c == "'":
                    quote = c
                    inner.append(c)
                elif c == close:
                    break
                else:
                    inner.append(c)
                j += 1
            if j >= n:
                raise Complaint("'%s' has no closing '%s'" % (line[i:], close))
            if j + 1 < n and line[j + 1] not in ' \t':
                raise Complaint("'%s' runs on after its '%s'" % (line[i:].split()[0], close))
            words.append(Word('opt' if close == ']' else 'req', ''.join(inner)))
            i = j + 1
            continue
        if line[i] == '"' or (re.match(r'[A-Za-z0-9_-]+\."', line[i:])):
            user = None
            m = re.match(r'([A-Za-z0-9_-]+)\."', line[i:])
            if m:
                user = m.group(1)
                i += len(m.group(1)) + 1
            j = line.find('"', i + 1)
            if j < 0:
                raise Complaint('a label has no closing double quote: %s' % line[i:])
            name = line[i + 1:j]
            if not NAME_PART.match(name):
                raise Complaint('"%s" is not a label: letters, digits, _ and -' % name)
            if j + 1 < n and line[j + 1] not in ' \t':
                raise Complaint('a label is a word of its own: %s' % line[i:].split()[0])
            words.append(Word('ref' if user else 'label', name, user=user))
            i = j + 1
            continue
        text, bare = [], True
        while i < n and line[i] not in ' \t':
            c = line[i]
            if c == "'":
                j = line.find("'", i + 1)
                if j < 0:
                    raise Complaint('a quote is not closed: %s' % line[i:])
                text.append(line[i + 1:j])
                bare = False
                i = j + 1
            elif c == '\\' and i + 1 < n:
                text.append(line[i + 1])
                bare = False
                i += 2
            elif c == '"':
                raise Complaint('double quotes are for labels; text and locators take single quotes: %s' % line)
            else:
                text.append(c)
                i += 1
        words.append(Word('word', ''.join(text), bare))
    return words


def unquote(s):
    """A parameter's value: single quotes and backslashes as in a word."""
    ws = split_words(s) if s else [Word('word', '', True)]
    if len(ws) != 1 or ws[0].kind != 'word':
        raise Complaint("'%s' is not a value" % s)
    return ws[0].text


