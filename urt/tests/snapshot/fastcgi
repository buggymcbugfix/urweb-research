#!/usr/bin/env python3
#
# A stand-in for an Ur/Web application built with -protocol fastcgi, for
# urt/check: the stand-in compiler beside this script makes PROJECT.exe
# run it, for a project called *serves* that it is asked to build so.
# Like the real one it takes its connections from the listening socket it
# is handed as descriptor 0.  It says on stderr that it has started, and
# answers every request with its number and what it was given: the
# parameters, sorted, and the body, in brackets.  Some paths make it do
# what an application might:
#
#   /debug     a line on stdout, as `debug` prints
#   /err       a line on stderr, as a fatal error is reported
#   /log       a line on its FastCGI stderr stream, for the web server's log
#   /noend     an answer, and then the connection closed without the
#              FCGI_END_REQUEST that says the request is over
#   /proto3    an answer whose FCGI_END_REQUEST refuses the request
#              (protocolStatus FCGI_UNKNOWN_ROLE, 3) with status 0
#   /id2       an answer for request 2 (status 7) first, then the usual
#              one for the request as it was numbered
#   /bye       an answer ended as usual, and then the connection closed,
#              even when the request asked for it to be kept
#   /bye-late  the same, but the connection closed only once the next
#              request has come on it, which is left unread: the close
#              crosses the web server's next request
#   /drop      no answer: the request read to its end, and then the
#              connection closed
#   /dml       a statement appended to $URWEB_DML_LOG, as a DML would be
#   /env/NAME  an answer that ends in NAME=value, as the process's
#              environment has it, or in "NAME is not set"
#
# A request that asks for its connection to be kept (FCGI_KEEP_CONN) gets
# it kept, and its answer says which request on that connection it is.
# APP_MODE=exit1 makes it exit 1 before anything, with a line on stderr.

import os
import select
import socket
import struct
import sys

BEGIN_REQUEST, END_REQUEST, PARAMS, STDIN, STDOUT, STDERR = 1, 3, 4, 5, 6, 7


def read_exact(conn, n):
    data = b""
    while len(data) < n:
        chunk = conn.recv(n - len(data))
        if not chunk:
            raise EOFError
        data += chunk
    return data


def read_record(conn):
    _, kind, request_id, length, padding, _ = struct.unpack(">BBHHBB", read_exact(conn, 8))
    content = read_exact(conn, length)
    read_exact(conn, padding)
    return kind, request_id, content


def write_record(conn, kind, request_id, content):
    while True:
        part, content = content[:65535], content[65535:]
        conn.sendall(struct.pack(">BBHHBB", 1, kind, request_id, len(part), 0, 0) + part)
        if not content:
            return


def length(data, i):
    if data[i] < 128:
        return data[i], i + 1
    return struct.unpack(">I", data[i:i + 4])[0] & 0x7FFFFFFF, i + 4


def pairs(data):
    out, i = {}, 0
    while i < len(data):
        n, i = length(data, i)
        v, i = length(data, i)
        out[data[i:i + n].decode()] = data[i + n:i + n + v].decode()
        i += n + v
    return out


if os.environ.get("APP_MODE", "") == "exit1":
    sys.stderr.write("fastcgi: refusing to start\n")
    sys.exit(1)
sys.stderr.write("fastcgi: started\n")
sys.stderr.flush()
listener = socket.socket(fileno=0)
number = 0
while True:
    conn, _ = listener.accept()
    on_conn = 0
    while True:
        params, body = b"", b""
        request_id, keep = 1, False
        try:
            while True:
                kind, request_id, content = read_record(conn)
                if kind == BEGIN_REQUEST:
                    keep = bool(content[2] & 1)  # FCGI_KEEP_CONN
                elif kind == PARAMS:
                    params += content
                elif kind == STDIN:
                    if not content:
                        break
                    body += content
        except EOFError:
            conn.close()
            break
        number += 1
        on_conn += 1
        env = pairs(params)
        path = env.get("PATH_INFO", "")
        if path == "/drop":
            conn.close()
            break
        if path == "/debug":
            sys.stdout.write("fastcgi: a line on stdout\n")
            sys.stdout.flush()
        elif path == "/err":
            sys.stderr.write("fastcgi: a line on stderr\n")
            sys.stderr.flush()
        elif path == "/dml":
            with open(os.environ["URWEB_DML_LOG"], "a") as log:
                log.write("INSERT INTO t VALUES (3);\n")
        answer = "%d: %d parameters\n" % (number, len(env))
        answer += "".join("%s=%s\n" % (k, env[k]) for k in sorted(env))
        answer += "body: [%s]\n" % body.decode()
        if path.startswith("/env/"):
            name = path[len("/env/"):]
            answer += "%s=%s\n" % (name, os.environ[name]) if name in os.environ else "%s is not set\n" % name
        if keep:
            answer += "kept: request %d on this connection\n" % on_conn
        write_record(conn, STDOUT, request_id, b"Content-type: text/plain\r\n\r\n" + answer.encode())
        if path == "/log":
            write_record(conn, STDERR, request_id, b"fastcgi: a line for the web server's log\n")
        if path == "/noend":
            conn.close()
            break
        try:
            if path == "/id2":
                write_record(conn, STDOUT, 2, b"Content-type: text/plain\r\n\r\nfor request 2\n")
                write_record(conn, STDOUT, 2, b"")
                conn.sendall(struct.pack(">BBHHBB", 1, END_REQUEST, 2, 8, 0, 0) + struct.pack(">IB", 7, 0) + bytes(3))
            write_record(conn, STDOUT, request_id, b"")
            conn.sendall(struct.pack(">BBHHBB", 1, END_REQUEST, request_id, 8, 0, 0)
                         + struct.pack(">IB", 0, 3 if path == "/proto3" else 0) + bytes(3))
        except (BrokenPipeError, ConnectionResetError):
            # The other side may stop reading at an earlier record (/id2): its
            # outcome to record, not ours to die of.
            pass
        if not keep or path == "/bye":
            conn.close()
            break
        if path == "/bye-late":
            select.select([conn], [], [])
            conn.close()
            break
