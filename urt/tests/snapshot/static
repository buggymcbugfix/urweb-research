#!/bin/sh
#
# A stand-in for an Ur/Web application built with -protocol static, for
# urt/check: the stand-in compiler beside this script makes PROJECT.exe
# run it, for a project called *serves* that it is asked to build so.
# It prints a page that shows what it was given: its arguments, and the
# clock and seed urt pinned.  The path /fail makes it fail as the
# runtime does, with a line on stderr and exit status 1.

if [ "${1-}" = /fail ]; then
    echo "Error: as asked" >&2
    exit 1
fi
printf '<html><body>%s argument: %s</body></html>\n' "$#" "${1-}"
env | LC_ALL=C sort | grep -E '^URWEB_REPRODUCIBLE_[A-Z_]*='
